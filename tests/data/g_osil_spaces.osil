<?xml version="1.0" encoding="UTF-8"?>
<!-- names with spaces, as the COIN-OR OS sample files write them -->
<osil xmlns="os.optimizationservices.org">
<instanceHeader><name>Par, Inc. Example</name></instanceHeader>
<instanceData>
<variables numberOfVariables="2">
<var name="x 0" lb="0"/>
<var name="x1" lb="0"/>
</variables>
<objectives numberOfObjectives="1">
<obj name="Par, Inc. Objective Function" maxOrMin="max" numberOfObjCoef="2">
<coef idx="0">10</coef>
<coef idx="1">9</coef>
</obj>
</objectives>
<constraints numberOfConstraints="2">
<con name="cut and dye" ub="630"/>
<con name="sewing" ub="600"/>
</constraints>
<linearConstraintCoefficients numberOfValues="4">
<start><el>0</el><el>2</el><el>4</el></start>
<rowIdx><el>0</el><el>1</el><el>0</el><el>1</el></rowIdx>
<value><el>0.7</el><el>0.5</el><el>1</el><el>0.8333</el></value>
</linearConstraintCoefficients>
</instanceData>
</osil>
