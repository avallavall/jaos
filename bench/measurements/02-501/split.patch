+typedef struct {
+    int64_t at;
+    double t_at, t0, limit;
+    int cur, stop;
+    bool tree;
+    int64_t w[RS_N];
+    double s[RS_N];
+    int64_t lp_iters, lp_primal, lp_phase1, lp_rounds;
+    int lp_status;
+} rsplit;
+
+static void rs_to(rsplit *r, int64_t work, int next)
+{
+    const double now = now_seconds();
+    r->w[r->cur] += work - r->at;
+    r->s[r->cur] += now - r->t_at;
+    if (r->stop < 0 && r->limit > 0.0 && now - r->t0 >= r->limit)
+        r->stop = r->cur;
+    r->at = work;
+    r->t_at = now;
+    r->cur = r->tree ? RS_TREE : next;
+}
+
+static void rs_log(jaos_model *m, rsplit *r, int64_t work)
+{
+    const int at_end = r->cur;
+    rs_to(r, work, RS_OTHER);
+    if (m->cfg.mip_sub)
+        return;
+    char buf[4096];
+    snprintf(buf, sizeof buf,
+                     "root split: total %lld work %.2f s; stop %s; end %s; "
+                     "lp iters %lld primal %lld phase1 %lld status %d "
+                     "presolve rounds %lld;",
+                     (long long)work, now_seconds() - r->t0,
+                     r->stop >= 0 ? rs_names[r->stop] : "none",
+                     rs_names[at_end], (long long)r->lp_iters,
+                     (long long)r->lp_primal, (long long)r->lp_phase1,
+                     r->lp_status, (long long)r->lp_rounds);
+    jm_log(m, JAOS_LOG_SUMMARY, "%s", buf);
+    for (int k = 0; k < RS_N; k++)
+        if (r->w[k] != 0 || r->s[k] > 0.005)
+            jm_log(m, JAOS_LOG_SUMMARY, "root piece: %s %lld %.2f",
+                   rs_names[k], (long long)r->w[k], r->s[k]);
+}
