+static int64_t gdive_pick(const jaos_model *m, const jaos_model *hv,
+                          const ghstate *g, int rule, const double *cur,
+                          const double *xinc, const double *pc_sum,
+                          const int64_t *pc_n, const double *pavg, bool *up)
+{
+    const int64_t nc = m->num_col;
+    int64_t pick = -1;
+    double b0 = 0.0, b1 = 0.0;
+    bool bu = false;
+    for (int64_t j = 0; j < nc; j++) {
+        if (!m->col_integer[j] || !(hv->col_lower[j] < hv->col_upper[j]))
+            continue;
+        const double v = cur[j], fl = floor(v), f = v - fl;
+        if (f <= MIP_INT_TOL || f >= 1.0 - MIP_INT_TOL)
+            continue;
+        bool u = f >= 0.5;
+        double s0 = 0.0, s1 = 0.0;
+        if (rule == GH_COEF) {
+            const int64_t lu = g->lk_up[j], ld = g->lk_dn[j];
+            u = lu < ld ? true : ld < lu ? false : f >= 0.5;
+            s0 = (double)(u ? lu : ld) + (lu == 0 || ld == 0 ? 1e30 : 0.0);
+            s1 = u ? 1.0 - f : f;
+        } else if (rule == GH_PSCOST) {
+            const double pd = pc_n[j] > 0 ? pc_sum[j] / (double)pc_n[j]
+                                          : pavg[0];
+            const double pu = pc_n[nc + j] > 0
+                ? pc_sum[nc + j] / (double)pc_n[nc + j] : pavg[1];
+            const double r = g->have_root ? g->xroot[j] : v;
+            if (v < r - 0.4)
+                u = false;
+            else if (v > r + 0.4)
+                u = true;
+            else if (f < 0.3)
+                u = false;
+            else if (f > 0.7)
+                u = true;
+            else
+                u = !(pd * f < pu * (1.0 - f));
+            const double cd = pd * f, cu = pu * (1.0 - f);
+            const double q = u ? (1.0 + cd) / (1.0 + cu)
+                               : (1.0 + cu) / (1.0 + cd);
+            const bool bin = m->col_lower[j] == 0.0 && m->col_upper[j] == 1.0;
+            s0 = bin ? 0.0 : 1.0;
+            s1 = -q;
+        } else if (rule == GH_GUIDED) {
+            const double t = jm_round(xinc[j]);
+            u = t > v;
+            s0 = fabs(v - t);
+        } else {
+            const double r = g->xroot[j];
+            if (v > r + MIP_INT_TOL) {
+                u = true;
+                s0 = (1.0 - f) / (v - r);
+            } else if (v < r - MIP_INT_TOL) {
+                u = false;
+                s0 = f / (r - v);
+            } else {
+                continue;
+            }
+        }
+        if (pick < 0 || s0 < b0 || (s0 == b0 && s1 < b1)) {
+            pick = j;
+            b0 = s0;
+            b1 = s1;
+            bu = u;
+        }
+    }
+    *up = bu;
+    return pick;
+}
