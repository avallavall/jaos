+static int gdive_for_point(const jaos_model *m, const jaos_model *lp,
+                           ghstate *g, int rule, const double *x,
+                           const double *xinc, double inckey, double sigma,
+                           const double *pc_sum, const int64_t *pc_n,
+                           int64_t stop, double *out, double *xr, double *ra,
+                           int64_t *work, int64_t *solves_done)
+{
+    const int64_t nc = m->num_col;
+    double pavg[2] = {1.0, 1.0};
+    if (rule == GH_PSCOST) {
+        for (int d = 0; d < 2; d++) {
+            double sum = 0.0;
+            int64_t cnt = 0;
+            for (int64_t j = 0; j < nc; j++)
+                if (pc_n[d * nc + j] > 0) {
+                    sum += pc_sum[d * nc + j] / (double)pc_n[d * nc + j];
+                    cnt++;
+                }
+            if (cnt > 0)
+                pavg[d] = sum / (double)cnt;
+        }
+        *work += 2 * nc;
+    }
+    jaos_model *hv = nullptr;
+    if (jaos_model_copy(lp, &hv) != JAOS_OK)
+        return -1;
+    double *cur = g->cur;
+    if (nc > 0)
+        memcpy(cur, x, (size_t)nc * sizeof *cur);
+    int rc = 0;
+    for (int64_t s = 0;; s++) {
+        double obj = 0.0;
+        *work += m->num_nz + nc + m->num_row;
+        if (rounded_point(m, cur, xr, ra, &obj)) {
+            if (sigma * obj < inckey) {
+                if (nc > 0)
+                    memcpy(out, cur, (size_t)nc * sizeof *out);
+                rc = 1;
+            }
+            break;
+        }
+        if (s >= MIP_GDIVE_SOLVES)
+            break;
+        bool up = false;
+        *work += nc;
+        const int64_t j = gdive_pick(m, hv, g, rule, cur, xinc, pc_sum, pc_n,
+                                     pavg, &up);
+        if (j < 0)
+            break;
+        const double lo = hv->col_lower[j], hi = hv->col_upper[j];
+        const double fl = floor(cur[j]);
+        bool ok = false;
+        for (int t = 0; t < 2 && !ok; t++) {
+            const bool u = t == 0 ? up : !up;
+            if (jaos_set_col_bounds(hv, j, u ? fl + 1.0 : lo, u ? hi : fl) !=
+                JAOS_OK)
+                goto out;
+            if (!heur_budget(hv, m, *work, stop))
+                goto out;
+            if (jaos_solve(hv) != JAOS_OK)
+                goto out;
+            *work += jaos_work_units(hv);
+            (*solves_done)++;
+            const jaos_solve_status ns = jaos_status_of(hv);
+            if (ns == JAOS_SOLVE_OPTIMAL) {
+                double z = 0.0;
+                if (jaos_objective(hv, &z) != JAOS_OK ||
+                    jaos_solution(hv, cur, nullptr, nullptr, nullptr) !=
+                        JAOS_OK)
+                    goto out;
+                ok = sigma * z < inckey;
+            } else if (ns != JAOS_SOLVE_INFEASIBLE) {
+                goto out;
+            }
+        }
+        if (!ok)
+            break;
+    }
+out:
+    jaos_model_free(hv);
+    return rc;
+}
