+static jaos_model *wide_normal_lp(int64_t threads)
+{
+    enum { R = 400, C = 800 };
+    static int64_t as[C + 1], ai[R * C];
+    static double av[R * C], cost[C], cl[C], cu[C], rl[R], ru[R], ax[R];
+    uint64_t seed = 12345;
+    int64_t nz = 0;
+    memset(ax, 0, sizeof ax);
+    for (int64_t j = 0; j < C; j++) {
+        as[j] = nz;
+        for (int64_t i = 0; i < R; i++) {
+            seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+            if ((seed >> 33) % 100 >= 8)
+                continue;
+            const double v = (double)((seed >> 40) % 19) - 9.0;
+            if (v == 0.0)
+                continue;
+            ai[nz] = i;
+            av[nz++] = v;
+            ax[i] += 5.0 * v;
+        }
+        seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+        cost[j] = (double)((seed >> 40) % 21) - 10.0;
+        cl[j] = 0.0;
+        cu[j] = 10.0;
+    }
+    as[C] = nz;
+    for (int64_t i = 0; i < R; i++) {
+        rl[i] = ax[i] - 1.0;
+        ru[i] = ax[i] + 1.0;
+    }
+    jaos_model *m = nullptr;
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_model_new(&m));
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_load_lp(m, C, R, JAOS_MINIMIZE, 0.0,
+                                                cost, cl, cu, rl, ru,
+                                                nz, as, ai, av));
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_set_threads(m, threads));
+    return m;
+}
+
+static void test_the_normal_matrix_formed_on_threads_is_bit_identical(void)
+{
+    jaos_model *a = wide_normal_lp(1);
+    jaos_model *b = wide_normal_lp(3);
+    TEST_ASSERT_EQUAL_DOUBLE(solve_with(a, JAOS_ALGORITHM_BARRIER),
+                             solve_with(b, JAOS_ALGORITHM_BARRIER));
+    TEST_ASSERT_EQUAL_INT(JAOS_SOLVE_OPTIMAL, jaos_status_of(a));
+    TEST_ASSERT_EQUAL_INT64(jaos_work_units(a), jaos_work_units(b));
+    TEST_ASSERT_EQUAL_INT64(jaos_iterations(a), jaos_iterations(b));
+    static double xa[800], xb[800], ya[400], yb[400];
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_solution(a, xa, nullptr, ya, nullptr));
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_solution(b, xb, nullptr, yb, nullptr));
+    TEST_ASSERT_EQUAL_MEMORY(xa, xb, sizeof xa);
+    TEST_ASSERT_EQUAL_MEMORY(ya, yb, sizeof ya);
+    jaos_model_free(a);
+    jaos_model_free(b);
+}
