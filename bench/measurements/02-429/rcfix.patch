+static jaos_status ct_rcfix(const jaos_model *m, jaos_model *rel, double sigma,
+                            double thr, ct_node *cur, double *red,
+                            int64_t *col, double *lo, double *hi,
+                            int64_t *fixed)
+{
+    *fixed = 0;
+    double lb = -INFINITY;
+    jaos_status st = ct_dual_bound(rel, sigma, &lb, red);
+    if (st != JAOS_OK || !(lb < thr))
+        return st;
+    int64_t k = 0;
+    for (int64_t j = 0; j < m->num_col; j++) {
+        const double r = red[j];
+        if (!m->col_integer[j] || ct_semi(m, j) || isnan(r) || r == 0.0)
+            continue;
+        const double l = rel->col_lower[j], u = rel->col_upper[j];
+        const double t = floor((thr - lb) / fabs(r) + CT_INT_TOL);
+        if (r > 0.0 && isfinite(l) && l + t < u) {
+            col[k] = j;
+            lo[k] = l;
+            hi[k++] = l + t;
+        } else if (r < 0.0 && isfinite(u) && u - t > l) {
+            col[k] = j;
+            lo[k] = u - t;
+            hi[k++] = u;
+        }
+    }
+    if (k == 0)
+        return JAOS_OK;
+    const int64_t n = cur->nfix + k;
+    int64_t *nc = jm_alloc_array(n, sizeof *nc);
+    double *nl = jm_alloc_array(n, sizeof *nl);
+    double *nh = jm_alloc_array(n, sizeof *nh);
+    if (nc == nullptr || nl == nullptr || nh == nullptr) {
+        free(nc);
+        free(nl);
+        free(nh);
+        return JAOS_ERR_OUT_OF_MEMORY;
+    }
+    if (cur->nfix > 0) {
+        memcpy(nc, cur->col, (size_t)cur->nfix * sizeof *nc);
+        memcpy(nl, cur->lo, (size_t)cur->nfix * sizeof *nl);
+        memcpy(nh, cur->hi, (size_t)cur->nfix * sizeof *nh);
+    }
+    memcpy(nc + cur->nfix, col, (size_t)k * sizeof *nc);
+    memcpy(nl + cur->nfix, lo, (size_t)k * sizeof *nl);
+    memcpy(nh + cur->nfix, hi, (size_t)k * sizeof *nh);
+    free(cur->col);
+    free(cur->lo);
+    free(cur->hi);
+    cur->col = nc;
+    cur->lo = nl;
+    cur->hi = nh;
+    cur->nfix = n;
+    for (int64_t q = 0; q < k; q++) {
+        st = jaos_set_col_bounds(rel, col[q], lo[q], hi[q]);
+        if (st != JAOS_OK)
+            return st;
+    }
+    *fixed = k;
+    return JAOS_OK;
+}
