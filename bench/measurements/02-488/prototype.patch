+static unsigned gh_mask = 0;
+static double gh_dshare = MIP_GDIVE_SHARE, gh_cshare = MIP_CROSS_SHARE,
+              gh_mshare = MIP_MUT_SHARE;
+static int64_t gh_devery = MIP_GDIVE_EVERY;
+static double gh_croot = MIP_SUBMIP_ROOT;
