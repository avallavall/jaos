+static int zi_for_point(const jaos_model *m, const double *x,
+                        const double *rowact, double sigma, double *out,
+                        double *act, int64_t *work)
+{
+    const int64_t nc = m->num_col, nr = m->num_row;
+    const double tol = 0.5 * jm_primal_tolerance(m);
+    int64_t ops = nc, nfrac = 0;
+    for (int64_t j = 0; j < nc; j++) {
+        out[j] = x[j];
+        if (!m->col_integer[j] || fabs(x[j] - jm_round(x[j])) <= MIP_INT_TOL)
+            continue;
+        if (semi_live(m, j)) {
+            *work += ops;
+            return 0;
+        }
+        nfrac++;
+    }
+    if (nfrac == 0) {
+        *work += ops;
+        return 0;
+    }
+    if (rowact != nullptr) {
+        if (nr > 0)
+            memcpy(act, rowact, (size_t)nr * sizeof *act);
+        ops += nr;
+    } else {
+        for (int64_t i = 0; i < nr; i++)
+            act[i] = 0.0;
+        for (int64_t j = 0; j < nc; j++) {
+            if (out[j] == 0.0)
+                continue;
+            for (int64_t k = m->a_start[j]; k < m->a_start[j + 1]; k++)
+                act[m->a_index[k]] += m->a_value[k] * out[j];
+        }
+        ops += nr + m->num_nz;
+    }
+    for (int64_t pass = 0; pass < MIP_ZI_PASSES && nfrac > 0; pass++) {
+        bool moved = false;
+        for (int64_t j = 0; j < nc; j++) {
+            if (!m->col_integer[j])
+                continue;
+            const double v = out[j], fl = floor(v), f = v - fl;
+            if (f <= MIP_INT_TOL || f >= 1.0 - MIP_INT_TOL)
+                continue;
+            double up = fmax(m->col_upper[j] - v, 0.0);
+            double dn = fmax(v - m->col_lower[j], 0.0);
+            for (int64_t k = m->a_start[j]; k < m->a_start[j + 1]; k++) {
+                const int64_t i = m->a_index[k];
+                const double a = m->a_value[k];
+                const double hi = fmax(m->row_upper[i] + tol - act[i], 0.0);
+                const double lo = fmax(act[i] - m->row_lower[i] + tol, 0.0);
+                if (a > 0.0) {
+                    up = fmin(up, hi / a);
+                    dn = fmin(dn, lo / a);
+                } else if (a < 0.0) {
+                    up = fmin(up, lo / -a);
+                    dn = fmin(dn, hi / -a);
+                }
+            }
+            ops += m->a_start[j + 1] - m->a_start[j];
+            const double tu = up >= 1.0 - f ? fl + 1.0 : v + up;
+            const double td = dn >= f ? fl : v - dn;
+            const double z0 = f < 1.0 - f ? f : 1.0 - f;
+            const double zu = fmin(tu - fl, fl + 1.0 - tu);
+            const double zd = fmin(td - fl, fl + 1.0 - td);
+            double t;
+            if (zu < zd)
+                t = tu;
+            else if (zd < zu)
+                t = td;
+            else {
+                const double c = sigma * m->col_cost[j];
+                const double cu = c * (tu - v), cd = c * (td - v);
+                t = cu < cd ? tu : cd < cu ? td : f >= 0.5 ? tu : td;
+            }
+            const double z = t == tu ? zu : zd;
+            if (!(z < z0))
+                continue;
+            for (int64_t k = m->a_start[j]; k < m->a_start[j + 1]; k++)
+                act[m->a_index[k]] += m->a_value[k] * (t - v);
+            ops += m->a_start[j + 1] - m->a_start[j];
+            out[j] = t;
+            moved = true;
+            if (z <= MIP_INT_TOL)
+                nfrac--;
+        }
+        if (!moved)
+            break;
+    }
+    *work += ops;
+    return nfrac == 0;
+}
+
+static int64_t gdive_pick(const jaos_model *m, const jaos_model *hv,
+                          const ghstate *g, int rule, const double *cur,
+                          const double *xinc, double sigma,
+                          const double *pc_sum, const int64_t *pc_n,
+                          const double *pavg, bool *up)
+{
+    const int64_t nc = m->num_col;
+    int64_t pick = -1;
+    double b0 = 0.0, b1 = 0.0;
+    bool bu = false;
+    for (int64_t j = 0; j < nc; j++) {
+        if (!m->col_integer[j] || !(hv->col_lower[j] < hv->col_upper[j]))
+            continue;
+        const double v = cur[j], fl = floor(v), f = v - fl;
+        if (f <= MIP_INT_TOL || f >= 1.0 - MIP_INT_TOL)
+            continue;
+        bool u = f >= 0.5;
+        double s0 = 0.0, s1 = 0.0;
+        if (rule == GH_COEF) {
+            const int64_t lu = g->lk_up[j], ld = g->lk_dn[j];
+            u = lu < ld ? true : ld < lu ? false : f >= 0.5;
+            s0 = (double)(u ? lu : ld) + (lu == 0 || ld == 0 ? 1e30 : 0.0);
+            s1 = u ? 1.0 - f : f;
+        } else if (rule == GH_PSCOST) {
+            const double pd = pc_n[j] > 0 ? pc_sum[j] / (double)pc_n[j]
+                                          : pavg[0];
+            const double pu = pc_n[nc + j] > 0
+                ? pc_sum[nc + j] / (double)pc_n[nc + j] : pavg[1];
+            const double r = g->have_root ? g->xroot[j] : v;
+            if (v < r - 0.4)
+                u = false;
+            else if (v > r + 0.4)
+                u = true;
+            else if (f < 0.3)
+                u = false;
+            else if (f > 0.7)
+                u = true;
+            else
+                u = !(pd * f < pu * (1.0 - f));
+            const double cd = pd * f, cu = pu * (1.0 - f);
+            const double q = u ? (1.0 + cd) / (1.0 + cu) : (1.0 + cu) / (1.0 + cd);
+            const bool bin = m->col_lower[j] == 0.0 && m->col_upper[j] == 1.0;
+            s0 = bin ? 0.0 : 1.0;
+            s1 = -q;
+        } else if (rule == GH_GUIDED) {
+            const double t = jm_round(xinc[j]);
+            u = t > v;
+            s0 = fabs(v - t);
+            s1 = 0.0;
+        } else if (rule == GH_VLEN) {
+            const double c = sigma * m->col_cost[j];
+            u = c >= 0.0;
+            const double delta = u ? (1.0 - f) * c : -f * c;
+            const double len = (double)(m->a_start[j + 1] - m->a_start[j]) + 1.0;
+            const bool bin = m->col_lower[j] == 0.0 && m->col_upper[j] == 1.0;
+            s0 = bin ? 0.0 : 1.0;
+            s1 = delta / len;
+        } else {
+            if (!g->have_root)
+                continue;
+            const double r = g->xroot[j];
+            if (v > r + MIP_INT_TOL) {
+                u = true;
+                s0 = (1.0 - f) / (v - r);
+            } else if (v < r - MIP_INT_TOL) {
+                u = false;
+                s0 = f / (r - v);
+            } else {
+                continue;
+            }
+        }
+        if (pick < 0 || s0 < b0 || (s0 == b0 && s1 < b1)) {
+            pick = j;
+            b0 = s0;
+            b1 = s1;
+            bu = u;
+        }
+    }
+    *up = bu;
+    return pick;
+}
+
+static int gdive_for_point(const jaos_model *m, const jaos_model *lp,
+                           ghstate *g, int rule, const double *x,
+                           const double *xinc, double inckey, double sigma,
+                           const double *pc_sum, const int64_t *pc_n,
+                           int64_t stop, double *out, double *xr, double *ra,
+                           int64_t *work, int64_t *solves_done)
+{
+    const int64_t nc = m->num_col;
+    double pavg[2] = {1.0, 1.0};
+    if (rule == GH_PSCOST) {
+        for (int d = 0; d < 2; d++) {
+            double sum = 0.0;
+            int64_t cnt = 0;
+            for (int64_t j = 0; j < nc; j++)
+                if (pc_n[d * nc + j] > 0) {
+                    sum += pc_sum[d * nc + j] / (double)pc_n[d * nc + j];
+                    cnt++;
+                }
+            if (cnt > 0)
+                pavg[d] = sum / (double)cnt;
+        }
+        *work += 2 * nc;
+    }
+    jaos_model *hv = nullptr;
+    if (jaos_model_copy(lp, &hv) != JAOS_OK)
+        return -1;
+    double *cur = g->cur;
+    if (nc > 0)
+        memcpy(cur, x, (size_t)nc * sizeof *cur);
+    int rc = 0;
+    for (int64_t s = 0;; s++) {
+        double obj = 0.0;
+        *work += m->num_nz + nc + m->num_row;
+        if (rounded_point(m, cur, xr, ra, &obj)) {
+            if (sigma * obj < inckey) {
+                if (nc > 0)
+                    memcpy(out, cur, (size_t)nc * sizeof *out);
+                rc = 1;
+            }
+            break;
+        }
+        if (s >= MIP_GDIVE_SOLVES)
+            break;
+        bool up = false;
+        *work += nc;
+        const int64_t j = gdive_pick(m, hv, g, rule, cur, xinc, sigma, pc_sum,
+                                     pc_n, pavg, &up);
+        if (j < 0)
+            break;
+        const double lo = hv->col_lower[j], hi = hv->col_upper[j];
+        const double fl = floor(cur[j]);
+        bool ok = false;
+        for (int t = 0; t < 2 && !ok; t++) {
+            const bool u = t == 0 ? up : !up;
+            if (jaos_set_col_bounds(hv, j, u ? fl + 1.0 : lo, u ? hi : fl) !=
+                JAOS_OK)
+                goto out;
+            if (!heur_budget(hv, m, *work, stop))
+                goto out;
+            if (jaos_solve(hv) != JAOS_OK)
+                goto out;
+            *work += jaos_work_units(hv);
+            (*solves_done)++;
+            const jaos_solve_status ns = jaos_status_of(hv);
+            if (ns == JAOS_SOLVE_OPTIMAL) {
+                double z = 0.0;
+                if (jaos_objective(hv, &z) != JAOS_OK ||
+                    jaos_solution(hv, cur, nullptr, nullptr, nullptr) !=
+                        JAOS_OK)
+                    goto out;
+                ok = sigma * z < inckey;
+            } else if (ns != JAOS_SOLVE_INFEASIBLE) {
+                goto out;
+            }
+        }
+        if (!ok)
+            break;
+    }
+out:
+    jaos_model_free(hv);
+    return rc;
+}
+
+static int cross_for_point(const jaos_model *m, const double *ilo,
+                           const double *ihi, const double *pool, int64_t k,
+                           double incobj, int64_t limit, int64_t *work,
+                           double *out)
+{
+    const int64_t nc = m->num_col;
+    jaos_model *sub = nullptr;
+    if (jaos_model_copy(m, &sub) != JAOS_OK)
+        return -1;
+    int got = 0;
+    int64_t nint = 0, nfix = 0;
+    *work += k * nc;
+    for (int64_t j = 0; j < nc; j++) {
+        if (!m->col_integer[j] || semi_live(m, j))
+            continue;
+        nint++;
+        double lo = ilo[j], hi = ihi[j];
+        const double v = jm_round(pool[j]);
+        bool same = true;
+        for (int64_t p = 1; p < k && same; p++)
+            same = jm_round(pool[p * nc + j]) == v;
+        if (same && v >= lo && v <= hi) {
+            lo = hi = v;
+            nfix++;
+        }
+        if (jaos_set_col_bounds(sub, j, lo, hi) != JAOS_OK) {
+            got = -1;
+            goto out;
+        }
+    }
+    if (nint == 0 || nfix == nint ||
+        (double)nfix < MIP_CROSS_FIXED * (double)nint)
+        goto out;
+    got = submip_run(m, sub, incobj, limit, work, out);
+out:
+    jaos_model_free(sub);
+    return got;
+}
+
+static int mut_for_point(const jaos_model *m, const double *ilo,
+                         const double *ihi, const double *xinc, double incobj,
+                         uint64_t *rng, int64_t limit, int64_t *work,
+                         double *out)
+{
+    const int64_t nc = m->num_col;
+    jaos_model *sub = nullptr;
+    if (jaos_model_copy(m, &sub) != JAOS_OK)
+        return -1;
+    int got = 0;
+    int64_t nint = 0, nfix = 0;
+    const uint64_t cut = (uint64_t)(MIP_MUT_FIXED * 1048576.0);
+    *work += nc;
+    for (int64_t j = 0; j < nc; j++) {
+        if (!m->col_integer[j] || semi_live(m, j))
+            continue;
+        nint++;
+        double lo = ilo[j], hi = ihi[j];
+        const double v = jm_round(xinc[j]);
+        if ((sw_next(rng) >> 20) % 1048576u < cut && v >= lo && v <= hi) {
+            lo = hi = v;
+            nfix++;
+        }
+        if (jaos_set_col_bounds(sub, j, lo, hi) != JAOS_OK) {
+            got = -1;
+            goto out;
+        }
+    }
+    if (nint == 0 || nfix == nint)
+        goto out;
+    got = submip_run(m, sub, incobj, limit, work, out);
+out:
+    jaos_model_free(sub);
+    return got;
+}
+
+static int dins_for_point(const jaos_model *m, const double *ilo,
+                          const double *ihi, const double *xinc,
+                          double incobj, const double *x, const double *xroot,
+                          int64_t limit, int64_t *work, double *out)
+{
+    const int64_t nc = m->num_col;
+    jaos_model *sub = nullptr;
+    if (jaos_model_copy(m, &sub) != JAOS_OK)
+        return -1;
+    int got = 0;
+    int64_t nint = 0, nfix = 0;
+    *work += nc;
+    for (int64_t j = 0; j < nc; j++) {
+        if (!m->col_integer[j] || semi_live(m, j))
+            continue;
+        nint++;
+        const double v = jm_round(xinc[j]);
+        const double d = fabs(v - x[j]);
+        double lo = ilo[j], hi = ihi[j];
+        if (d < 0.5 && fabs(v - xroot[j]) < 0.5) {
+            lo = hi = v;
+        } else {
+            const double r = ceil(d - MIP_INT_TOL);
+            lo = fmax(lo, v - r);
+            hi = fmin(hi, v + r);
+        }
+        if (!(v >= ilo[j] && v <= ihi[j]) || lo > hi) {
+            lo = ilo[j];
+            hi = ihi[j];
+        }
+        nfix += lo == hi;
+        if (jaos_set_col_bounds(sub, j, lo, hi) != JAOS_OK) {
+            got = -1;
+            goto out;
+        }
+    }
+    if (nint == 0 || nfix == nint ||
+        (double)nfix < MIP_SUBMIP_FIXED * (double)nint)
+        goto out;
+    got = submip_run(m, sub, incobj, limit, work, out);
+out:
+    jaos_model_free(sub);
+    return got;
+}
+
+static int gh_pick(const ghstate *g, const int *cand, int n)
+{
+    int64_t total = 0;
+    for (int t = 0; t < n; t++)
+        total += g->calls[cand[t]];
+    const double reach = sqrt((double)total + 1.0);
+    int best = -1;
+    double bs = 0.0;
+    for (int t = 0; t < n; t++) {
+        const int h = cand[t];
+        const double s = (MIP_GH_REWARD * (double)g->points[h] + 1.0 + reach) /
+                         ((double)g->calls[h] + 1.0);
+        if (best < 0 || s > bs) {
+            best = h;
+            bs = s;
+        }
+    }
+    return best;
+}
+
+static int gh_for_point(const jaos_model *m, const jaos_model *lp,
+                        ghstate *g, int phase, int64_t nodes, const double *x,
+                        const double *xinc, double incobj, double inckey,
+                        double sigma, const double *pool,
