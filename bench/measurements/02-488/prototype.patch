+typedef struct {
+    bool ready, have_root;
+    int64_t *lk_up, *lk_dn;
+    double *xroot, *cur, *act;
+    int64_t setrows;
+    int64_t calls[GH_N], points[GH_N], spent[GH_N];
+    int64_t dive_spent;
+    int64_t cross_spent, cross_last;
