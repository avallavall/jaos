+static void gh_free(ghstate *g)
+{
+    free(g->lk_up);
+    free(g->lk_dn);
+    free(g->xroot);
+    free(g->cur);
+    free(g->act);
+}
+
+static bool gh_ready(const jaos_model *m, ghstate *g, int64_t *work)
+{
+    if (g->ready)
+        return true;
+    gh_knobs();
+    const int64_t nc = m->num_col, nr = m->num_row;
+    g->lk_up = jm_calloc_array(nc > 0 ? nc : 1, sizeof *g->lk_up);
+    g->lk_dn = jm_calloc_array(nc > 0 ? nc : 1, sizeof *g->lk_dn);
+    g->xroot = jm_alloc_array(nc > 0 ? nc : 1, sizeof *g->xroot);
+    g->cur = jm_alloc_array(nc > 0 ? nc : 1, sizeof *g->cur);
+    g->act = jm_calloc_array(nr > 0 ? nr : 1, sizeof *g->act);
+    if (g->lk_up == nullptr || g->lk_dn == nullptr || g->xroot == nullptr ||
+        g->cur == nullptr || g->act == nullptr)
+        return false;
+    bool *bad = (bool *)jm_calloc_array(nr > 0 ? nr : 1, sizeof *bad);
+    if (bad == nullptr)
+        return false;
+    for (int64_t j = 0; j < nc; j++) {
+        const bool bin = m->col_integer[j] && m->col_lower[j] == 0.0 &&
+                         m->col_upper[j] == 1.0;
+        for (int64_t k = m->a_start[j]; k < m->a_start[j + 1]; k++) {
+            const int64_t i = m->a_index[k];
+            const double a = m->a_value[k];
+            const bool hi = isfinite(m->row_upper[i]);
+            const bool lo = isfinite(m->row_lower[i]);
+            if ((a > 0.0 && hi) || (a < 0.0 && lo))
+                g->lk_up[j]++;
+            if ((a > 0.0 && lo) || (a < 0.0 && hi))
+                g->lk_dn[j]++;
+            if (!bin || a != 1.0)
+                bad[i] = true;
+        }
+    }
+    for (int64_t i = 0; i < nr; i++)
+        if (!bad[i] && m->row_lower[i] == 1.0)
+            g->setrows++;
+    free(bad);
+    *work += m->num_nz + nc + nr;
+    g->rng = 0x9E3779B97F4A7C15u;
+    g->ready = true;
+    return true;
+}
