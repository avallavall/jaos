+static void gh_knobs(void)
+{
+    const char *s = getenv("JAOS_GH");
+    gh_mask = s != nullptr ? (unsigned)strtoul(s, nullptr, 0) : 0u;
+    if ((s = getenv("JAOS_GH_DSHARE")) != nullptr)
+        gh_dshare = strtod(s, nullptr);
+    if ((s = getenv("JAOS_GH_CSHARE")) != nullptr)
+        gh_cshare = strtod(s, nullptr);
+    if ((s = getenv("JAOS_GH_MSHARE")) != nullptr)
+        gh_mshare = strtod(s, nullptr);
+    if ((s = getenv("JAOS_GH_DEVERY")) != nullptr)
+        gh_devery = strtoll(s, nullptr, 10);
+    if ((s = getenv("JAOS_GH_CROOT")) != nullptr)
+        gh_croot = strtod(s, nullptr);
+}
+
+static bool gh_on(int h)
+{
+    return (gh_mask >> h) & 1u;
+}
+
+static const char *gh_name(int h)
+{
+    switch (h) {
+    case GH_ZI: return "ZI rounding";
+    case GH_COEF: return "the coefficient dive";
+    case GH_PSCOST: return "the pseudocost dive";
+    case GH_GUIDED: return "the dive guided by the incumbent";
+    case GH_VLEN: return "the vector-length dive";
+    case GH_LINE: return "the line-search dive";
+    case GH_CROSS: return "crossover over the pool";
+    case GH_MUT: return "mutation of the incumbent";
+    case GH_DINS: return "a sub-MIP over the distances of the incumbent";
+    }
+    return "";
+}
