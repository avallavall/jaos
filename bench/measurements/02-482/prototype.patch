+typedef struct {
+    int64_t cap, n, width;
+    int64_t *len, *used, *col;
+    double *val;
+    signed char *dir;
+    int64_t made, pruned, fixed, replaced, tried, lits;
+} cpool;
+
+static void cpool_free(cpool *p)
+{
+    free(p->len); free(p->used); free(p->col); free(p->val); free(p->dir);
+    memset(p, 0, sizeof *p);
+}
+
+static bool cpool_add(cpool *p, const int64_t *col, const double *val,
+                      const signed char *dir, int64_t n, int64_t node,
+                      int64_t *work)
+{
+    if (p->col == nullptr) {
+        const int64_t w = p->cap * p->width;
+        p->len = jm_alloc_array(p->cap, sizeof *p->len);
+        p->used = jm_alloc_array(p->cap, sizeof *p->used);
+        p->col = jm_alloc_array(w, sizeof *p->col);
+        p->val = jm_alloc_array(w, sizeof *p->val);
+        p->dir = jm_alloc_array(w, sizeof *p->dir);
+        if (!p->len || !p->used || !p->col || !p->val || !p->dir)
+            return false;
+    }
+    int64_t s = p->n;
+    if (p->n == p->cap) {
+        s = 0;
+        for (int64_t t = 1; t < p->n; t++)
+            if (p->used[t] < p->used[s])
+                s = t;
+        *work += p->n;
+        p->replaced++;
+    } else {
+        p->n++;
+    }
+    p->len[s] = n;
+    p->used[s] = node;
+    memcpy(p->col + s * p->width, col, (size_t)n * sizeof *col);
+    memcpy(p->val + s * p->width, val, (size_t)n * sizeof *val);
+    memcpy(p->dir + s * p->width, dir, (size_t)n * sizeof *dir);
+    p->made++;
+    p->lits += n;
+    return true;
+}
+
+static int64_t stop_conflict(const jaos_model *m, const jaos_model *lp,
+                             const bnode *cur, const double *ilo,
+                             const double *ihi, int64_t nperm, double sigma,
+                             double cutoff, int64_t most, bool binary_only,
+                             bool rcf_ok, bool local_ok, double *dcol,
+                             int64_t *last,
+                             double *blo, double *bhi, int64_t *lcol,
+                             double *lval, signed char *ldir, double *base,
+                             int64_t *work)
+{
+    const int64_t nc = m->num_col, nrl = lp->num_row;
+    if (cur == nullptr || cur->nfix == 0 || m->row_ind_col != nullptr ||
+        m->num_sos > 0 || !lp->stop_duals_ok)
+        return 0;
+    const double *y = lp->sol_dual;
+    *work += lp->num_nz + nc + nrl;
+    const int64_t np = nperm < nrl ? nperm : nrl;
+    bool local = false;
+    for (int64_t i = np; i < nrl; i++)
+        local = local || y[i] != 0.0;
+    if (local && !local_ok)
+        return -4;
+    double rows = 0.0;
+    for (int64_t i = 0; i < np; i++) {
+        const double yk = sigma * y[i];
+        if (yk > 0.0) {
+            if (!isfinite(lp->row_lower[i]))
+                return -5;
+            rows += yk * lp->row_lower[i];
+        } else if (yk < 0.0) {
+            if (!isfinite(lp->row_upper[i]))
+                return -5;
+            rows += yk * lp->row_upper[i];
+        }
+    }
+    for (int64_t j = 0; j < nc; j++) {
+        double a = sigma * lp->col_cost[j], mag = fabs(a);
+        for (int64_t p = lp->a_start[j]; p < lp->a_start[j + 1]; p++) {
+            const int64_t i = lp->a_index[p];
+            if (i < np) {
+                a -= lp->a_value[p] * sigma * y[i];
+                mag += fabs(lp->a_value[p] * y[i]);
+            }
+        }
+        const bool basic = !local &&
+                           lp->sol_col_status[j] == JAOS_BASIS_BASIC;
+        dcol[j] = basic && (!lp->stop_duals_reduced ||
+                            (sc_roundoff && fabs(a) <= MIP_PROOF_ROUNDOFF * mag))
+            ? 0.0 : a;
+        last[j] = -1;
+        blo[j] = ilo[j];
+        bhi[j] = ihi[j];
+    }
+    for (int64_t k = 0; k < cur->nfix; k++) {
+        const int64_t j = cur->col[k];
+        last[j] = k;
+        blo[j] = cur->lo[k];
+        bhi[j] = cur->hi[k];
+    }
+    if (sc_lp_bounds)
+        for (int64_t j = 0; j < nc; j++) {
+            if (lp->col_lower[j] > blo[j])
+                blo[j] = lp->col_lower[j];
+            if (lp->col_upper[j] < bhi[j])
+                bhi[j] = lp->col_upper[j];
+        }
+    double low = rows + sigma * lp->obj_offset;
+    *base = low;
+    for (int64_t j = 0; j < nc; j++) {
+        const double d = dcol[j];
+        if (d > 0.0) {
+            if (!isfinite(blo[j]))
+                return -5;
+            low += d * blo[j];
+        } else if (d < 0.0) {
+            if (!isfinite(bhi[j]))
+                return -5;
+            low += d * bhi[j];
+        }
+    }
+    const double tol = MIP_CONFLICT_GAP * (1.0 + fabs(cutoff));
+    double gap = low - cutoff;
+    if (!(gap > tol))
+        return -2;
+    int64_t kept = 0;
+    for (int64_t j = 0; sc_lp_bounds && j < nc; j++) {
+        if (last[j] >= 0)
+            continue;
+        const double d = dcol[j];
+        double delta = 0.0;
+        if (d > 0.0 && blo[j] > ilo[j])
+            delta = isfinite(ilo[j]) ? d * (blo[j] - ilo[j]) : INFINITY;
+        else if (d < 0.0 && bhi[j] < ihi[j])
+            delta = isfinite(ihi[j]) ? d * (bhi[j] - ihi[j]) : INFINITY;
+        else
+            continue;
+        if (gap - delta > tol) {
+            gap -= delta;
+            continue;
+        }
+        if (!m->col_integer[j] || !rcf_ok ||
+            (binary_only && (ilo[j] != 0.0 || ihi[j] != 1.0)) ||
+            kept == most)
+            return -3;
+        lcol[kept] = j;
+        ldir[kept] = d > 0.0 ? 1 : -1;
+        lval[kept] = d > 0.0 ? blo[j] : bhi[j];
+        kept++;
+        sc_rcf_lits++;
+    }
+    for (int64_t k = cur->nfix - 1; k >= 0; k--) {
+        const int64_t j = cur->col[k];
+        if (last[j] != k)
+            continue;
+        const double d = dcol[j];
+        double delta = 0.0;
+        if (d > 0.0)
+            delta = isfinite(ilo[j]) ? d * (blo[j] - ilo[j]) : INFINITY;
+        else if (d < 0.0)
+            delta = isfinite(ihi[j]) ? d * (bhi[j] - ihi[j]) : INFINITY;
+        if (gap - delta > tol) {
+            gap -= delta;
+            continue;
+        }
+        if (!m->col_integer[j] || (!rcf_ok && cur->rcf[k]) ||
+            (binary_only && (ilo[j] != 0.0 || ihi[j] != 1.0)) ||
+            kept == most)
+            return -3;
+        lcol[kept] = j;
+        ldir[kept] = d > 0.0 ? 1 : -1;
+        lval[kept] = d > 0.0 ? blo[j] : bhi[j];
+        kept++;
+        sc_rcf_lits += cur->rcf[k];
+    }
+    return kept;
+}
+
+static int cpool_propagate(cpool *p, const jaos_model *m, jaos_model *lp,
+                           bnode *cur, int64_t *pos, int64_t node,
+                           int64_t passes, int64_t *work)
+{
+    if (p->n == 0)
+        return 0;
+    for (int64_t k = 0; k < cur->nfix; k++)
+        pos[cur->col[k]] = k;
+    *work += cur->nfix;
+    int rc = 0;
+    for (int64_t pass = 0; pass < passes; pass++) {
+        bool moved = false;
+        for (int64_t s = 0; s < p->n && rc == 0; s++) {
+            const int64_t *col = p->col + s * p->width;
+            const double *val = p->val + s * p->width;
+            const signed char *dir = p->dir + s * p->width;
+            int64_t open = -1, opens = 0, t = 0;
+            for (; t < p->len[s]; t++) {
+                const int64_t j = col[t];
+                const double lo = lp->col_lower[j], hi = lp->col_upper[j];
+                const bool holds = dir[t] > 0 ? lo >= val[t] : hi <= val[t];
+                if (holds)
+                    continue;
+                const bool fails = dir[t] > 0 ? hi < val[t] : lo > val[t];
+                if (fails || ++opens > 1)
+                    break;
+                open = t;
+            }
+            *work += t + 1;
+            if (t < p->len[s])
+                continue;
+            p->used[s] = node;
+            if (opens == 0) {
+                p->pruned++;
+                rc = -1;
+                break;
+            }
+            const int64_t j = col[open];
+            double nlo = lp->col_lower[j], nhi = lp->col_upper[j];
+            if (dir[open] > 0)
+                nhi = val[open] - 1.0;
+            else
+                nlo = val[open] + 1.0;
+            if (nlo > nhi) {
+                p->pruned++;
+                rc = -1;
+                break;
+            }
+            if (jaos_set_col_bounds(lp, j, nlo, nhi) != JAOS_OK) {
+                rc = -2;
+                break;
+            }
+            if (pos[j] >= 0) {
+                cur->lo[pos[j]] = nlo;
+                cur->hi[pos[j]] = nhi;
+                cur->rcf[pos[j]] = true;
+            } else {
+                if (!node_add_fix(cur, j, nlo, nhi, true)) {
+                    rc = -2;
+                    break;
+                }
+                pos[j] = cur->nfix - 1;
+            }
+            p->fixed++;
+            moved = true;
+        }
+        if (rc != 0 || !moved)
+            break;
+    }
+    for (int64_t k = 0; k < cur->nfix; k++)
+        pos[cur->col[k]] = -1;
+    (void)m;
+    return rc;
+}
+
+typedef struct {
+    int64_t cap, n;
+    int64_t *len, *used;
+    int64_t **col;
+    double **val;
+    double *base;
+    int64_t made, pruned, fixed, replaced, refused, nz;
+    int64_t nc;
+    double *dense, *gmin, **pot;
+    bool prune_only;
+} ppool;
+
+static void ppool_free(ppool *p)
+{
+    for (int64_t s = 0; s < p->n; s++) {
+        free(p->col[s]);
+        free(p->val[s]);
+        if (p->pot != nullptr)
+            free(p->pot[s]);
+    }
+    free(p->len); free(p->used); free(p->col); free(p->val); free(p->base);
+    free(p->dense); free(p->gmin); free(p->pot);
+    memset(p, 0, sizeof *p);
+}
+
+static int pot_cmp(const void *a, const void *b)
+{
+    const double *x = a, *y = b;
+    if (x[0] != y[0])
+        return x[0] > y[0] ? -1 : 1;
+    return x[1] < y[1] ? -1 : x[1] > y[1] ? 1 : 0;
+}
+
+static bool ppool_index(ppool *p, int64_t s, const double *ilo,
+                        const double *ihi, int64_t *work)
+{
+    const int64_t n = p->len[s], nc = p->nc;
+    if (p->dense == nullptr) {
+        p->dense = calloc((size_t)(p->cap * nc), sizeof *p->dense);
+        p->gmin = jm_alloc_array(p->cap, sizeof *p->gmin);
+        p->pot = calloc((size_t)p->cap, sizeof *p->pot);
+        if (!p->dense || !p->gmin || !p->pot)
+            return false;
+    }
+    free(p->pot[s]);
+    p->pot[s] = jm_alloc_array(n > 0 ? 2 * n : 1, sizeof **p->pot);
+    if (p->pot[s] == nullptr)
+        return false;
+    double *row = p->dense + s * nc;
+    memset(row, 0, (size_t)nc * sizeof *row);
+    double g = p->base[s];
+    double *pv = p->pot[s];
+    for (int64_t t = 0; t < n; t++) {
+        const int64_t j = p->col[s][t];
+        const double d = p->val[s][t];
+        row[j] = d;
+        g += d > 0.0 ? d * ilo[j] : d * ihi[j];
+        pv[2 * t] = fabs(d) * (ihi[j] - ilo[j]);
+        pv[2 * t + 1] = (double)t;
+    }
+    p->gmin[s] = g;
+    qsort(pv, (size_t)n, 2 * sizeof *pv, pot_cmp);
+    *work += nc + n;
+    return true;
+}
+
+static bool ppool_add(ppool *p, const jaos_model *m, const double *ilo,
+                      const double *ihi, const double *d, double base,
+                      int64_t node, int64_t *work)
+{
+    const int64_t nc = m->num_col;
+    if (p->cap <= 0)
+        return true;
+    if (p->len == nullptr) {
+        p->len = jm_alloc_array(p->cap, sizeof *p->len);
+        p->used = jm_alloc_array(p->cap, sizeof *p->used);
+        p->col = calloc((size_t)p->cap, sizeof *p->col);
+        p->val = calloc((size_t)p->cap, sizeof *p->val);
+        p->base = jm_alloc_array(p->cap, sizeof *p->base);
+        if (!p->len || !p->used || !p->col || !p->val || !p->base)
+            return false;
+    }
+    int64_t n = 0;
+    double amax = 0.0, amin = INFINITY;
+    for (int64_t j = 0; j < nc; j++) {
+        if (d[j] == 0.0)
+            continue;
+        if (ilo[j] == ihi[j]) {
+            base += d[j] * ilo[j];
+            continue;
+        }
+        n++;
+        const double a = fabs(d[j]);
+        amax = a > amax ? a : amax;
+        amin = a < amin ? a : amin;
+    }
+    *work += nc;
+    if (n == 0 || amax > MIP_PROOF_RANGE * amin) {
+        p->refused++;
+        return true;
+    }
+    int64_t s = p->n;
+    if (p->n == p->cap) {
+        s = 0;
+        for (int64_t t = 1; t < p->n; t++)
+            if (p->used[t] < p->used[s])
+                s = t;
+        *work += p->n;
+        free(p->col[s]);
+        free(p->val[s]);
+        p->col[s] = nullptr;
+        p->val[s] = nullptr;
+        p->replaced++;
+    } else {
+        p->n++;
+    }
+    p->col[s] = jm_alloc_array(n, sizeof **p->col);
+    p->val[s] = jm_alloc_array(n, sizeof **p->val);
+    if (p->col[s] == nullptr || p->val[s] == nullptr)
+        return false;
+    int64_t k = 0;
+    for (int64_t j = 0; j < nc; j++) {
+        if (d[j] == 0.0 || ilo[j] == ihi[j])
+            continue;
+        p->col[s][k] = j;
+        p->val[s][k] = d[j];
+        k++;
+    }
+    p->len[s] = n;
+    p->used[s] = node;
+    p->base[s] = base;
+    p->made++;
+    p->nz += n;
+    if (p->nc > 0 && !ppool_index(p, s, ilo, ihi, work))
+        return false;
+    return true;
+}
+
+static int ppool_propagate_fast(ppool *p, const jaos_model *m, jaos_model *lp,
+                                bnode *cur, int64_t *pos, int64_t node,
+                                double cutoff, int64_t passes,
+                                const double *ilo, const double *ihi,
+                                int64_t *work)
+{
+    if (p->n == 0 || !isfinite(cutoff) || p->dense == nullptr)
+        return 0;
+    const int64_t nc = p->nc;
+    const double tol = MIP_CONFLICT_GAP * (1.0 + fabs(cutoff));
+    int rc = 0;
+    for (int64_t k = 0; k < cur->nfix; k++)
+        pos[cur->col[k]] = k;
+    *work += cur->nfix;
+    for (int64_t pass = 0; pass < passes && rc == 0; pass++) {
+        bool moved = false;
+        for (int64_t s = 0; s < p->n && rc == 0; s++) {
+            if (!isfinite(p->gmin[s]))
+                continue;
+            const double *row = p->dense + s * nc;
+            double act = p->gmin[s];
+            for (int64_t k = 0; k < cur->nfix; k++) {
+                const int64_t j = cur->col[k];
+                if (pos[j] != k)
+                    continue;
+                const double d = row[j];
+                if (d > 0.0)
+                    act += d * (cur->lo[k] - ilo[j]);
+                else if (d < 0.0)
+                    act += d * (cur->hi[k] - ihi[j]);
+            }
+            *work += cur->nfix + 1;
+            if (act - cutoff > tol) {
+                p->used[s] = node;
+                p->pruned++;
+                rc = -1;
+                break;
+            }
+            const double slack = cutoff - act;
+            const double *pv = p->pot[s];
+            for (int64_t t = 0; !p->prune_only && t < p->len[s]; t++) {
+                *work += 1;
+                if (!(pv[2 * t] > slack))
+                    break;
+                const int64_t tt = (int64_t)pv[2 * t + 1];
+                const int64_t j = p->col[s][tt];
+                if (!m->col_integer[j])
+                    continue;
+                const double a = p->val[s][tt];
+                const double blo = pos[j] >= 0 ? cur->lo[pos[j]] : ilo[j];
+                const double bhi = pos[j] >= 0 ? cur->hi[pos[j]] : ihi[j];
+                double nlo = lp->col_lower[j], nhi = lp->col_upper[j];
+                if (a > 0.0) {
+                    const double h = blo + floor(slack / a + MIP_RCFIX_SLACK);
+                    if (!(h < nhi))
+                        continue;
+                    nhi = h;
+                } else {
+                    const double l = bhi - floor(slack / -a + MIP_RCFIX_SLACK);
+                    if (!(l > nlo))
+                        continue;
+                    nlo = l;
+                }
+                p->used[s] = node;
+                if (nlo > nhi) {
+                    p->pruned++;
+                    rc = -1;
+                    break;
+                }
+                if (jaos_set_col_bounds(lp, j, nlo, nhi) != JAOS_OK) {
+                    rc = -2;
+                    break;
+                }
+                if (pos[j] >= 0) {
+                    cur->lo[pos[j]] = nlo;
+                    cur->hi[pos[j]] = nhi;
+                    cur->rcf[pos[j]] = true;
+                } else {
+                    if (!node_add_fix(cur, j, nlo, nhi, true)) {
+                        rc = -2;
+                        break;
+                    }
+                    pos[j] = cur->nfix - 1;
+                }
+                p->fixed++;
+                moved = true;
+            }
+        }
+        if (!moved)
+            break;
+    }
+    for (int64_t k = 0; k < cur->nfix; k++)
+        pos[cur->col[k]] = -1;
+    return rc;
+}
+
+static int ppool_propagate(ppool *p, const jaos_model *m, jaos_model *lp,
+                           bnode *cur, int64_t *pos, int64_t node,
+                           double cutoff, int64_t passes, int64_t *work)
+{
+    if (p->n == 0 || !isfinite(cutoff))
+        return 0;
+    for (int64_t k = 0; k < cur->nfix; k++)
+        pos[cur->col[k]] = k;
+    *work += cur->nfix;
+    const double tol = MIP_CONFLICT_GAP * (1.0 + fabs(cutoff));
+    int rc = 0;
+    for (int64_t pass = 0; pass < passes && rc == 0; pass++) {
+        bool moved = false;
+        for (int64_t s = 0; s < p->n && rc == 0; s++) {
+            const int64_t *col = p->col[s];
+            const double *val = p->val[s];
+            double low = p->base[s];
+            bool finite = true;
+            for (int64_t t = 0; t < p->len[s] && finite; t++) {
+                const int64_t j = col[t];
+                const double b = val[t] > 0.0 ? lp->col_lower[j]
+                                              : lp->col_upper[j];
+                finite = isfinite(b);
+                low += val[t] * b;
+            }
+            *work += p->len[s];
+            if (!finite)
+                continue;
+            if (low - cutoff > tol) {
+                p->used[s] = node;
+                p->pruned++;
+                rc = -1;
+                break;
+            }
+            const double room = cutoff - low;
+            for (int64_t t = 0; t < p->len[s]; t++) {
+                const int64_t j = col[t];
+                if (!m->col_integer[j])
+                    continue;
+                double nlo = lp->col_lower[j], nhi = lp->col_upper[j];
+                const double a = val[t];
+                if (a > 0.0)
+                    nhi = nlo + floor(room / a + MIP_RCFIX_SLACK);
+                else
