+static bool ecol_grow(ecol *c, int64_t need)
+{
+    int64_t ci = c->cap, cv = c->cap, cs = c->cap;
+    if (!jm_grow((void **)&c->idx, &ci, need, sizeof *c->idx) ||
+        !jm_grow((void **)&c->val, &cv, need, sizeof *c->val) ||
+        !jm_grow((void **)&c->slot, &cs, need, sizeof *c->slot))
+        return false;
+    int64_t cap = ci < cv ? ci : cv;
+    c->cap = cap < cs ? cap : cs;
+    return true;
+}
+
+static bool ecol_push(ecol *c, int64_t i, double x, int64_t slot)
+{
+    if (c->n == c->cap && !ecol_grow(c, c->n + 1))
+        return false;
+    c->idx[c->n] = i;
+    c->val[c->n] = x;
+    c->slot[c->n] = slot;
+    c->n++;
+    return true;
+}
+
+static void ecol_free(ecol *c)
+{
+    free(c->idx);
+    free(c->val);
+    free(c->slot);
+    memset(c, 0, sizeof *c);
+}
