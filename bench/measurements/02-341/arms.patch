+typedef struct {
+    bool built;
+    int64_t nn, na;
+    int64_t *row, *nodeof, *at, *ah, *acol, *uf, *next, *last, *size;
+    int64_t *nz;
+    cutrank *ord;
+    double *agg, *cmag;
+    bool *seen;
+} netset;
+
+static void netset_free(netset *g)
+{
+    free(g->row); free(g->nodeof); free(g->at); free(g->ah); free(g->acol);
+    free(g->ord); free(g->uf); free(g->next); free(g->last); free(g->size);
+    free(g->nz); free(g->agg); free(g->cmag); free(g->seen);
+    memset(g, 0, sizeof *g);
+}
+
+static bool netset_build(const jaos_model *m, jaos_model *lp, netset *g,
+                         int64_t *work)
+{
+    const int64_t nc = m->num_col, nr = m->num_row;
+    g->built = true;
+    g->nodeof = jm_alloc_array(nr > 0 ? nr : 1, sizeof *g->nodeof);
+    g->row = jm_alloc_array(nr > 0 ? nr : 1, sizeof *g->row);
+    if (g->nodeof == nullptr || g->row == nullptr)
+        return false;
+    *work += m->num_nz + nc + nr;
+    for (int64_t i = 0; i < nr; i++) {
+        g->nodeof[i] = -1;
+        const int64_t p0 = lp->ar_start[i], p1 = lp->ar_start[i + 1];
+        if (p1 - p0 < 2)
+            continue;
+        if (m->row_ind_col != nullptr && m->row_ind_col[i] >= 0)
+            continue;
+        bool ok = true;
+        for (int64_t p = p0; p < p1 && ok; p++)
+            ok = !m->col_integer[lp->ar_index[p]];
+        if (!ok)
+            continue;
+        g->nodeof[i] = g->nn;
+        g->row[g->nn++] = i;
+    }
+    if (g->nn < 3)
+        return true;
+    g->at = jm_alloc_array(nc > 0 ? nc : 1, sizeof *g->at);
+    g->ah = jm_alloc_array(nc > 0 ? nc : 1, sizeof *g->ah);
+    g->acol = jm_alloc_array(nc > 0 ? nc : 1, sizeof *g->acol);
+    if (g->at == nullptr || g->ah == nullptr || g->acol == nullptr)
+        return false;
+    for (int64_t j = 0; j < nc; j++) {
+        if (m->col_integer[j])
+            continue;
+        int64_t n1 = -1, n2 = -1, cnt = 0;
+        double a1 = 0.0, a2 = 0.0;
+        for (int64_t p = lp->a_start[j]; p < lp->a_start[j + 1]; p++) {
+            const int64_t i = lp->a_index[p];
+            if (i >= nr || g->nodeof[i] < 0)
+                continue;
+            cnt++;
+            if (cnt == 1) {
+                n1 = g->nodeof[i];
+                a1 = lp->a_value[p];
+            } else {
+                n2 = g->nodeof[i];
+                a2 = lp->a_value[p];
+            }
+        }
+        if (cnt != 2 || a1 != -a2 || n1 == n2)
+            continue;
+        g->at[g->na] = n1;
+        g->ah[g->na] = n2;
+        g->acol[g->na] = j;
+        g->na++;
+    }
+    if (g->na < 2)
+        return true;
+    const int64_t nn = g->nn;
+    g->ord = jm_alloc_array(g->na, sizeof *g->ord);
+    g->uf = jm_alloc_array(nn, sizeof *g->uf);
+    g->next = jm_alloc_array(nn, sizeof *g->next);
+    g->last = jm_alloc_array(nn, sizeof *g->last);
+    g->size = jm_alloc_array(nn, sizeof *g->size);
+    g->nz = jm_alloc_array(nc > 0 ? nc : 1, sizeof *g->nz);
+    g->agg = jm_calloc_array(nc > 0 ? nc : 1, sizeof *g->agg);
+    g->cmag = jm_calloc_array(nc > 0 ? nc : 1, sizeof *g->cmag);
+    g->seen = jm_calloc_array(nc > 0 ? nc : 1, sizeof *g->seen);
+    return g->ord != nullptr && g->uf != nullptr && g->next != nullptr &&
+           g->last != nullptr && g->size != nullptr && g->nz != nullptr &&
+           g->agg != nullptr && g->cmag != nullptr && g->seen != nullptr;
+}
+
+static int netset_cut(const jaos_model *m, jaos_model *lp, const double *x,
+                      const double *ilo, const double *ihi, cmir_ctx *cx,
+                      netset *g, const bool *in_s, int64_t size, cutbuf *cb,
+                      int64_t *work)
+{
+    int got = 0;
+    bool *const seen = g->seen;
+    for (int orient = 0; orient < 2; orient++) {
+        const double sg = orient == 0 ? 1.0 : -1.0;
+        bool ok = true;
+        for (int64_t v = 0; v < g->nn && ok; v++)
+            if (in_s[v])
+                ok = isfinite(orient == 0 ? lp->row_upper[g->row[v]]
+                                          : lp->row_lower[g->row[v]]);
+        if (!ok)
+            continue;
+        double b = 0.0, mag = 0.0;
+        int64_t nnz = 0;
+        for (int64_t v = 0; v < g->nn; v++) {
+            if (!in_s[v])
+                continue;
+            const int64_t i = g->row[v];
+            const double bd = orient == 0 ? lp->row_upper[i] : lp->row_lower[i];
+            b += sg * bd;
+            mag += fabs(bd);
+            for (int64_t p = lp->ar_start[i]; p < lp->ar_start[i + 1]; p++) {
+                const int64_t j = lp->ar_index[p];
+                g->agg[j] += sg * lp->ar_value[p];
+                g->cmag[j] += fabs(lp->ar_value[p]);
+                if (!seen[j]) {
+                    seen[j] = true;
+                    g->nz[nnz++] = j;
+                }
+            }
+        }
+        *work += nnz * (MIP_MIR_DELTAS + 2) + g->nn;
+        int64_t kept = 0;
+        for (int64_t q = 0; q < nnz; q++) {
+            const int64_t j = g->nz[q];
+            seen[j] = false;
+            if (g->agg[j] != 0.0)
+                g->nz[kept++] = j;
+            else
+                g->cmag[j] = 0.0;
+        }
+        qsort(g->nz, (size_t)kept, sizeof *g->nz, mir_col_cmp);
+        const int pushed = kept > 0
+            ? cmir_side(m, lp, x, ilo, ihi, cx, g->agg, b, mag, size, g->cmag,
+                        g->nz, kept, cb, work)
+            : 0;
+        for (int64_t q = 0; q < kept; q++) {
+            g->agg[g->nz[q]] = 0.0;
+            g->cmag[g->nz[q]] = 0.0;
+        }
+        if (pushed < 0)
+            return -1;
+        got += pushed;
+    }
+    return got;
+}
+
+static int64_t netset_mincut(const jaos_model *m, jaos_model *lp,
+                             const double *x, const double *ilo,
+                             const double *ihi, cmir_ctx *cx, netset *g,
+                             cutbuf *cb, int64_t *work)
+{
+    const int64_t nn = g->nn, na = g->na, ns = nn + 1, src = nn;
+    int64_t ne = 2 * na + 2 * nn;
+    int64_t *head = jm_alloc_array(ne, sizeof *head);
+    int64_t *nxt = jm_alloc_array(ne, sizeof *nxt);
+    int64_t *first = jm_alloc_array(ns, sizeof *first);
+    double *cap = jm_alloc_array(ne, sizeof *cap);
+    double *flow = jm_alloc_array(ne, sizeof *flow);
+    int64_t *pred = jm_alloc_array(ns, sizeof *pred);
+    int64_t *queue = jm_alloc_array(ns, sizeof *queue);
+    double *dem = jm_calloc_array(nn, sizeof *dem);
+    bool *in_s = jm_alloc_array(nn, sizeof *in_s);
+    int64_t added = -1;
+    if (head == nullptr || nxt == nullptr || first == nullptr ||
+        cap == nullptr || flow == nullptr || pred == nullptr ||
+        queue == nullptr || dem == nullptr || in_s == nullptr)
+        goto out;
+    for (int64_t v = 0; v < ns; v++)
+        first[v] = -1;
+    ne = 0;
+    for (int64_t a = 0; a < na; a++) {
+        const int64_t j = g->acol[a];
+        double into_ah = 0.0;
+        for (int64_t p = lp->a_start[j]; p < lp->a_start[j + 1]; p++)
+            if (lp->a_index[p] == g->row[g->ah[a]])
+                into_ah = lp->a_value[p];
+        const int64_t u = into_ah > 0.0 ? g->at[a] : g->ah[a];
+        const int64_t w = into_ah > 0.0 ? g->ah[a] : g->at[a];
+        const int64_t y = cx->vub_y[j];
+        const double c = y >= 0 ? (x[y] > 0.0 ? x[y] : 0.0) : INFINITY;
+        head[ne] = w; cap[ne] = c; nxt[ne] = first[u]; first[u] = ne; ne++;
+        head[ne] = u; cap[ne] = 0.0; nxt[ne] = first[w]; first[w] = ne; ne++;
+    }
+    for (int64_t v = 0; v < nn; v++) {
+        const int64_t i = g->row[v];
+        const double lo = lp->row_lower[i], up = lp->row_upper[i];
+        dem[v] = isfinite(lo) ? lo : isfinite(up) ? up : 0.0;
+        if (dem[v] < 0.0) {
+            head[ne] = v; cap[ne] = INFINITY; nxt[ne] = first[src];
+            first[src] = ne; ne++;
+            head[ne] = src; cap[ne] = 0.0; nxt[ne] = first[v]; first[v] = ne;
+            ne++;
+        }
+    }
+    *work += ne + ns;
+    added = 0;
+    for (int64_t t = 0; t < nn; t++) {
+        if (!(dem[t] > 0.0))
+            continue;
+        for (int64_t e = 0; e < ne; e++)
+            flow[e] = 0.0;
+        double total = 0.0;
+        for (;;) {
+            for (int64_t v = 0; v < ns; v++)
+                pred[v] = -2;
+            int64_t qh = 0, qt = 0;
+            queue[qt++] = src;
+            pred[src] = -1;
+            while (qh < qt && pred[t] == -2) {
+                const int64_t v = queue[qh++];
+                for (int64_t e = first[v]; e >= 0; e = nxt[e]) {
+                    const int64_t w = head[e];
+                    if (pred[w] != -2 || cap[e] - flow[e] <= 1e-9)
+                        continue;
+                    pred[w] = e;
+                    queue[qt++] = w;
+                }
+            }
+            *work += ne;
+            if (pred[t] == -2)
+                break;
+            double push = INFINITY;
+            for (int64_t v = t; v != src; v = head[pred[v] ^ 1])
+                if (cap[pred[v]] - flow[pred[v]] < push)
+                    push = cap[pred[v]] - flow[pred[v]];
+            if (!isfinite(push) || push <= 0.0) {
+                total = INFINITY;
+                break;
+            }
+            for (int64_t v = t; v != src; v = head[pred[v] ^ 1]) {
+                flow[pred[v]] += push;
+                flow[pred[v] ^ 1] -= push;
+            }
+            total += push;
+            if (total >= 1.0 - 1e-6)
+                break;
+        }
+        if (total >= 1.0 - 1e-6)
+            continue;
+        int64_t size = 0;
+        for (int64_t v = 0; v < nn; v++) {
+            in_s[v] = pred[v] == -2;
+            size += in_s[v];
+        }
+        if (size == 0 || size == nn)
+            continue;
+        const int got = netset_cut(m, lp, x, ilo, ihi, cx, g, in_s, size, cb,
+                                   work);
+        if (got < 0) {
+            added = -1;
+            goto out;
+        }
+        added += got;
+    }
+out:
+    free(head); free(nxt); free(first); free(cap); free(flow); free(pred);
+    free(queue); free(dem); free(in_s);
+    return added;
+}
+
+static int64_t netset_find(int64_t *uf, int64_t v)
+{
+    while (uf[v] != v) {
+        uf[v] = uf[uf[v]];
+        v = uf[v];
+    }
+    return v;
+}
+
+static int64_t netset_round(const jaos_model *m, jaos_model *lp,
+                            const double *x, const double *ilo,
+                            const double *ihi, cmir_ctx *cx, netset *g,
+                            int mode, cutbuf *cb, int64_t *work)
+{
+    if (jm_model_ensure_rowwise(lp) != JAOS_OK)
+        return -1;
+    if (!g->built && !netset_build(m, lp, g, work))
+        return -1;
+    if (g->na < 2 || g->nn < 3)
+        return 0;
+    if (mode == 2)
+        return netset_mincut(m, lp, x, ilo, ihi, cx, g, cb, work);
+    if (mode == 3) {
+        const int64_t a1 = netset_round(m, lp, x, ilo, ihi, cx, g, 1, cb,
+                                        work);
+        if (a1 < 0)
+            return -1;
+        const int64_t a2 = netset_round(m, lp, x, ilo, ihi, cx, g, 4, cb,
+                                        work);
+        return a2 < 0 ? -1 : a1 + a2;
+    }
+    const int64_t nn = g->nn, na = g->na;
+    bool *const seen = g->seen;
+    for (int64_t a = 0; a < na; a++) {
+        const int64_t y = cx->vub_y[g->acol[a]];
+        const double k = y < 0 ? 3.0 : mode == 4 ? -x[y] : x[y];
+        g->ord[a] = (cutrank){k, a};
+    }
+    qsort(g->ord, (size_t)na, sizeof *g->ord, cutrank_cmp);
+    for (int64_t v = 0; v < nn; v++) {
+        g->uf[v] = v;
+        g->next[v] = -1;
+        g->last[v] = v;
+        g->size[v] = 1;
+    }
+    *work += na * 4 + nn;
+    int64_t added = 0;
+    for (int64_t t = 0; t < na; t++) {
+        const int64_t a = g->ord[t].r;
+        int64_t ra = netset_find(g->uf, g->at[a]);
+        int64_t rb = netset_find(g->uf, g->ah[a]);
+        if (ra == rb)
+            continue;
+        if (g->size[ra] < g->size[rb] ||
+            (g->size[ra] == g->size[rb] && rb < ra)) {
+            const int64_t s = ra;
+            ra = rb;
+            rb = s;
+        }
+        g->uf[rb] = ra;
+        g->next[g->last[ra]] = rb;
+        g->last[ra] = g->last[rb];
+        g->size[ra] += g->size[rb];
+        if (g->size[ra] > nn / 2)
+            continue;
+        for (int orient = 0; orient < 2; orient++) {
+            const double sg = orient == 0 ? 1.0 : -1.0;
+            bool ok = true;
+            for (int64_t v = ra; v >= 0 && ok; v = g->next[v]) {
+                const int64_t i = g->row[v];
+                ok = isfinite(orient == 0 ? lp->row_upper[i]
+                                          : lp->row_lower[i]);
+            }
+            if (!ok)
+                continue;
+            double b = 0.0, mag = 0.0;
+            int64_t nnz = 0;
+            for (int64_t v = ra; v >= 0; v = g->next[v]) {
+                const int64_t i = g->row[v];
+                const double bd = orient == 0 ? lp->row_upper[i]
+                                              : lp->row_lower[i];
+                b += sg * bd;
+                mag += fabs(bd);
+                for (int64_t p = lp->ar_start[i]; p < lp->ar_start[i + 1];
+                     p++) {
+                    const int64_t j = lp->ar_index[p];
+                    g->agg[j] += sg * lp->ar_value[p];
+                    g->cmag[j] += fabs(lp->ar_value[p]);
+                    if (!seen[j]) {
+                        seen[j] = true;
+                        g->nz[nnz++] = j;
+                    }
+                }
+            }
+            *work += nnz * (MIP_MIR_DELTAS + 2);
+            int64_t kept = 0;
+            for (int64_t q = 0; q < nnz; q++) {
+                const int64_t j = g->nz[q];
+                seen[j] = false;
+                if (g->agg[j] != 0.0)
+                    g->nz[kept++] = j;
+                else
+                    g->cmag[j] = 0.0;
+            }
+            qsort(g->nz, (size_t)kept, sizeof *g->nz, mir_col_cmp);
+            const int pushed = kept > 0
+                ? cmir_side(m, lp, x, ilo, ihi, cx, g->agg, b, mag,
+                            g->size[ra], g->cmag, g->nz, kept, cb, work)
+                : 0;
+            if (getenv("JAOS_NSDBG") != nullptr) {
+                double ys = 0.0, xs = 0.0;
+                int64_t nin = 0, nout = 0, noth = 0;
+                for (int64_t q = 0; q < kept; q++) {
+                    const int64_t j = g->nz[q];
+                    const int64_t y = cx->vub_y[j];
+                    if (y >= 0 && g->agg[j] < 0.0) {
+                        ys += x[y];
+                        xs += x[j];
+                        nin++;
+                    } else if (y >= 0) {
+                        nout++;
+                    } else {
+                        noth++;
+                    }
+                }
+                fprintf(stderr, "NSDBG size %lld orient %d b %.6g nnz %lld "
+                        "neg-arcs %lld (y sum %.4g, x sum %.6g) pos-arcs %lld "
+                        "other %lld pushed %d\n", (long long)g->size[ra],
+                        orient, b, (long long)kept, (long long)nin, ys, xs,
+                        (long long)nout, (long long)noth, pushed);
+            }
+            for (int64_t q = 0; q < kept; q++) {
+                g->agg[g->nz[q]] = 0.0;
+                g->cmag[g->nz[q]] = 0.0;
+            }
+            if (pushed < 0)
+                return -1;
+            added += pushed;
+        }
+    }
     return added;
 }
 
