+static double *sb_gain_proto = nullptr;
+
+static void sb_note(int64_t nc, int64_t j, int d, jaos_solve_status o,
+                    double gain)
+{
+    if (sb_gain_proto == nullptr)
+        return;
+    if (o == JAOS_SOLVE_INFEASIBLE)
+        sb_gain_proto[d * nc + j] = INFINITY;
+    else if (o == JAOS_SOLVE_OPTIMAL || o == JAOS_SOLVE_WORK_LIMIT)
+        sb_gain_proto[d * nc + j] = gain > 0.0 ? gain : 0.0;
+}
+
+static int64_t select_branch_sb(const jaos_model *m, const double *x,
+                                const double *pc_sum, const int64_t *pc_n,
+                                const double *g, double cap)
+{
+    const int64_t nc = m->num_col;
+    int64_t branch = -1;
+    double best = -1.0, best_away = -1.0;
+    for (int64_t j = 0; j < nc; j++) {
+        if (!m->col_integer[j])
+            continue;
+        const double f = x[j] - floor(x[j]);
+        if (f <= MIP_INT_TOL || f >= 1.0 - MIP_INT_TOL)
+            continue;
+        double qd = isnan(g[j]) ? f * pseudocost(j, 0, nc, pc_sum, pc_n) : g[j];
+        double qu = isnan(g[nc + j]) ? (1.0 - f) * pseudocost(j, 1, nc, pc_sum, pc_n)
+                                     : g[nc + j];
+        if (qd > cap)
+            qd = cap;
+        if (qu > cap)
+            qu = cap;
+        const double score = (qd > MIP_PC_EPS ? qd : MIP_PC_EPS) *
+                             (qu > MIP_PC_EPS ? qu : MIP_PC_EPS);
+        const double away = f < 1.0 - f ? f : 1.0 - f;
+        if (score > best || (score == best && away > best_away)) {
+            best = score;
+            best_away = away;
+            branch = j;
+        }
+    }
+    return branch;
+}
