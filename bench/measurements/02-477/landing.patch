+    static int64_t a[P][P];
+    uint64_t s = 7;
+    for (int64_t i = 0; i < P; i++)
+        for (int64_t k = i + 1; k < P; k++) {
+            s = (s * 1103515245u + 12345u) % 2147483648u;
+            a[i][k] = a[k][i] = 1 + (int64_t)(s >> 16) % 5;
+        }
+    for (int64_t t = 0; t < TWINS; t++)
+        for (int64_t l = 0; l < P; l++)
+            if (l != 2 * t && l != 2 * t + 1)
