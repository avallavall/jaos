+#if !defined(JAOS_PRESOLVE_FAULT_OFFBYONE) && !defined(JAOS_PRESOLVE_FAULT_WRONGDUAL)
+static jaos_model *make_duplicate_rows(double scale, double k_rl, double k_ru,
+                                       double i_rl, double i_ru)
+{
+    const double c[] = {1.0, 2.0, 3.0};
+    const double cl[] = {0.0, 0.0, 0.0}, cu[] = {10.0, 10.0, 10.0};
+    const double rl[] = {i_rl, k_rl, 0.0}, ru[] = {i_ru, k_ru, INFINITY};
+    const int64_t s[] = {0, 3, 6, 8};
+    const int64_t ix[] = {0, 1, 2, 0, 1, 2, 0, 1};
+    const double v[] = {1.0, scale, 1.0, 1.0, scale, 2.0, 1.0, scale};
+    jaos_model *m = nullptr;
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_model_new(&m));
+    TEST_ASSERT_EQUAL_INT(JAOS_OK,
+        jaos_load_lp(m, 3, 3, JAOS_MINIMIZE, 0.0, c, cl, cu, rl, ru,
+                     8, s, ix, v));
+    return m;
+}
