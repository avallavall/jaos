+typedef struct {
+    uint64_t key;
+    int64_t row;
+} ps_rowkey;
+
+static int ps_rowkey_cmp(const void *a, const void *b)
+{
+    const ps_rowkey *x = a, *y = b;
+    if (x->key != y->key)
+        return x->key < y->key ? -1 : 1;
+    return (x->row > y->row) - (x->row < y->row);
+}
+
+static uint64_t ps_row_key(const ps_rowwise *rw, const bool *col_dead,
+                           int64_t i)
+{
+    uint64_t h = 1469598103934665603u;
+    double first = 0.0;
+    for (int64_t q = rw->rs[i]; q < rw->rs[i + 1]; q++) {
+        if (col_dead[rw->ridx[q]] || rw->rval[q] == 0.0)
+            continue;
+        if (first == 0.0)
+            first = rw->rval[q];
+        const double ratio = rw->rval[q] / first;
+        uint64_t bits;
+        memcpy(&bits, &ratio, sizeof bits);
+        bits &= ~(uint64_t)0xFFFFFF;
+        h = (h ^ (uint64_t)rw->ridx[q]) * 1099511628211u;
+        h = (h ^ bits) * 1099511628211u;
+    }
+    return h;
+}
+
+static bool ps_rows_parallel(const ps_rowwise *rw, const bool *col_dead,
+                             int64_t i, int64_t k, double *lambda)
+{
+    int64_t a = rw->rs[i], b = rw->rs[k];
+    const int64_t ae = rw->rs[i + 1], be = rw->rs[k + 1];
+    double lam = 0.0;
+    for (;;) {
+        while (a < ae && (col_dead[rw->ridx[a]] || rw->rval[a] == 0.0))
+            a++;
+        while (b < be && (col_dead[rw->ridx[b]] || rw->rval[b] == 0.0))
+            b++;
+        if (a == ae || b == be)
+            break;
+        if (rw->ridx[a] != rw->ridx[b])
+            return false;
+        if (lam == 0.0)
+            lam = rw->rval[b] / rw->rval[a];
+        if (rw->rval[b] != lam * rw->rval[a])
+            return false;
+        a++;
+        b++;
+    }
+    if (a != ae || b != be || lam == 0.0 || !isfinite(lam))
+        return false;
+    *lambda = lam;
+    return true;
+}
+
+static jaos_status ps_duplicate_rows(const jaos_model *m, jm_presolve *p,
+                                     const ps_rowwise *rw, bool *row_dead,
+                                     const bool *row_frozen,
+                                     const bool *col_dead,
+                                     const int64_t *row_deg, int64_t *col_deg,
+                                     double *cur_rl, double *cur_ru,
+                                     ps_acc *cur_rl_acc, ps_acc *cur_ru_acc,
+                                     double *row_traffic, jm_work *w,
+                                     bool *changed)
+{
+    const int64_t nr = m->num_row;
+    if (nr < 2 || m->rq_nz > 0 || m->num_cone > 0)
+        return JAOS_OK;
+    ps_rowkey *keys = jm_alloc_array(nr, sizeof *keys);
+    if (keys == nullptr)
+        return JAOS_ERR_OUT_OF_MEMORY;
+    int64_t nk = 0;
+    for (int64_t i = 0; i < nr; i++) {
+        if (row_dead[i] || row_frozen[i] || row_deg[i] < 2 ||
+            (m->row_ind_col != nullptr && m->row_ind_col[i] >= 0))
+            continue;
+        keys[nk++] = (ps_rowkey){ ps_row_key(rw, col_dead, i), i };
+        jm_work_add(w, (rw->rs[i + 1] - rw->rs[i]) * JM_WORK_NONZERO);
+    }
+    qsort(keys, (size_t)nk, sizeof *keys, ps_rowkey_cmp);
+    jm_work_add(w, nk * JM_WORK_NONZERO);
+
+    jaos_status st = JAOS_OK;
+    for (int64_t a = 0; a < nk; a++) {
+        const int64_t i = keys[a].row;
+        if (row_dead[i])
+            continue;
+        for (int64_t b = a + 1; b < nk && keys[b].key == keys[a].key; b++) {
+            const int64_t k = keys[b].row;
+            if (row_dead[k])
+                continue;
+            jm_work_add(w, (rw->rs[k + 1] - rw->rs[k]) * JM_WORK_NONZERO);
+            double lam;
+            if (!ps_rows_parallel(rw, col_dead, i, k, &lam))
+                continue;
+            double klo, khi;
+            if (lam > 0.0) {
+                klo = isfinite(cur_rl[k]) ? cur_rl[k] / lam : -HUGE_VAL;
+                khi = isfinite(cur_ru[k]) ? cur_ru[k] / lam : HUGE_VAL;
+            } else {
+                klo = isfinite(cur_ru[k]) ? cur_ru[k] / lam : -HUGE_VAL;
+                khi = isfinite(cur_rl[k]) ? cur_rl[k] / lam : HUGE_VAL;
+            }
+            const bool t_lo = klo > cur_rl[i], t_hi = khi < cur_ru[i];
+            if ((t_lo ? klo : cur_rl[i]) > (t_hi ? khi : cur_ru[i]))
+                continue;
+            if (!ps_push(p, (jm_presolve_rec){
+                    .tag = JM_PS_DUPLICATE_ROW, .index = k, .index2 = i,
+                    .coef = lam, .lo = klo, .hi = khi,
+                    .row_lo = cur_rl[i], .row_hi = cur_ru[i],
+                    .row_tightens_lo = t_lo, .row_tightens_hi = t_hi })) {
+                st = JAOS_ERR_OUT_OF_MEMORY;
+                goto out;
+            }
+            if (t_lo) {
+                cur_rl[i] = klo;
+                cur_rl_acc[i] = (ps_acc){ .sum = klo };
+            }
+            if (t_hi) {
+                cur_ru[i] = khi;
+                cur_ru_acc[i] = (ps_acc){ .sum = khi };
+            }
+            if (t_lo || t_hi) {
+                const double kt = row_traffic[k] / fabs(lam);
+                if (kt > row_traffic[i])
+                    row_traffic[i] = kt;
+            }
+            for (int64_t q = rw->rs[k]; q < rw->rs[k + 1]; q++)
+                if (!col_dead[rw->ridx[q]])
+                    col_deg[rw->ridx[q]]--;
+            row_dead[k] = true;
+            p->counts.duplicate_row++;
+            *changed = true;
+        }
+    }
+out:
+    free(keys);
+    return st;
+}
