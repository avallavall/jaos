+    TEST_IGNORE_MESSAGE("positive test — skipped under either fault build");
+#else
+    jaos_model *m = make_duplicate_rows(-2.0, -INFINITY, -4.0, 1.0, INFINITY);
+    const double y_want[3] = {0.0, -0.5, 0.0};
+    const jaos_basis_status rs_want[3] = {
+        JAOS_BASIS_BASIC, JAOS_BASIS_AT_UPPER, JAOS_BASIS_BASIC };
+    check_duplicate_solution(m, 2.0, y_want, rs_want);
