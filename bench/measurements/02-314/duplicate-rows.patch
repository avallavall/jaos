+static void check_duplicate_solution(jaos_model *m, double obj_want,
+                                     const double *y_want,
+                                     const jaos_basis_status *rs_want)
+{
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_solve(m));
+    TEST_ASSERT_EQUAL_INT(JAOS_SOLVE_OPTIMAL, jaos_status_of(m));
+    double obj = 0.0;
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_objective(m, &obj));
+    TEST_ASSERT_DOUBLE_WITHIN(TOL, obj_want, obj);
+    double x[3], y[3];
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_solution(m, x, nullptr, y, nullptr));
+    for (int i = 0; i < 3; i++)
+        TEST_ASSERT_DOUBLE_WITHIN(TOL, y_want[i], y[i]);
+    jaos_check_report r;
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_check_solution(m, x, y, TOL, &r));
+    TEST_ASSERT_TRUE(r.primal_feasible);
+    TEST_ASSERT_TRUE(r.dual_feasible);
+    jaos_basis_status cs[3], rs[3];
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_basis(m, cs, rs));
+    int64_t basic = 0;
+    for (int64_t j = 0; j < 3; j++)
+        basic += cs[j] == JAOS_BASIS_BASIC;
+    for (int64_t i = 0; i < 3; i++) {
+        basic += rs[i] == JAOS_BASIS_BASIC;
+        TEST_ASSERT_EQUAL_INT(rs_want[i], rs[i]);
+    }
+    TEST_ASSERT_EQUAL_INT64(3, basic);
+#if !defined(JAOS_NO_PRESOLVE)
+    jaos_presolve_report rep;
+    TEST_ASSERT_EQUAL_INT(JAOS_OK, jaos_presolve_result(m, &rep));
+    TEST_ASSERT_EQUAL_INT64(1, rep.duplicate_row);
+#endif
+}
+#endif
