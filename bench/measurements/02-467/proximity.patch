+static int proximity_for_point(const jaos_model *m, const double *ilo,
+                               const double *ihi, const double *xinc,
+                               double incobj, double step, int64_t limit,
+                               int64_t *work, double *xout)
+{
+    const int64_t nc = m->num_col;
+    int64_t nb = 0, ones = 0, nz = 0;
+    for (int64_t j = 0; j < nc; j++) {
+        if (lb_binary(m, j) && ilo[j] < ihi[j]) {
+            nb++;
+            ones += xinc[j] > 0.5;
+        }
+        nz += m->col_cost[j] != 0.0;
+    }
+    *work += nc;
+    if (nb == 0 || nz == 0)
+        return 0;
+    int64_t *idx = jm_alloc_array(nz, sizeof *idx);
+    double *val = jm_alloc_array(nz, sizeof *val);
+    jaos_model *sub = nullptr;
+    int got = -1;
+    if (idx == nullptr || val == nullptr ||
+        jaos_model_copy(m, &sub) != JAOS_OK)
+        goto out;
+    int64_t k = 0;
+    for (int64_t j = 0; j < nc; j++) {
+        if (m->col_cost[j] != 0.0) {
+            idx[k] = j;
+            val[k] = m->col_cost[j];
+            k++;
+        }
+        if (m->col_integer[j] &&
+            jaos_set_col_bounds(sub, j, ilo[j], ihi[j]) != JAOS_OK)
+            goto out;
+    }
+    const double delta = step > 0.0 ? step
+                                    : MIP_PROX_DELTA * (1.0 + fabs(incobj));
+    const bool max = m->sense == JAOS_MAXIMIZE;
+    const double lo = max ? incobj + delta - m->obj_offset : -INFINITY;
+    const double hi = max ? INFINITY : incobj - delta - m->obj_offset;
+    const int64_t start[2] = {0, nz};
+    if (jaos_add_rows(sub, 1, &lo, &hi, nz, start, idx, val) != JAOS_OK)
+        goto out;
+    for (int64_t j = 0; j < nc; j++) {
+        const double c = lb_binary(m, j) && ilo[j] < ihi[j]
+                             ? (xinc[j] > 0.5 ? -1.0 : 1.0) : 0.0;
+        if (jaos_set_col_cost(sub, j, c) != JAOS_OK)
+            goto out;
+    }
+    if (jaos_set_objective_sense(sub, JAOS_MINIMIZE) != JAOS_OK ||
+        jaos_set_objective_offset(sub, (double)ones) != JAOS_OK)
+        goto out;
+    free(sub->mip_start);
+    sub->mip_start = nullptr;
+    sub->cfg.log_cb = nullptr;
+    sub->cfg.log_level = JAOS_LOG_OFF;
+    sub->cfg.progress_cb = nullptr;
+    sub->cfg.incumbent_cb = nullptr;
+    sub->cfg.node_cb = nullptr;
+    sub->cfg.time_limit = 0.0;
+    sub->cfg.mip_local_branching_set = true;
+    sub->cfg.mip_local_branching = 0;
+    sub->cfg.mip_rins_set = true;
+    sub->cfg.mip_rins = 0;
+    sub->cfg.mip_restart_set = true;
+    sub->cfg.mip_restart = false;
+    sub->cfg.mip_node_limit = MIP_SUBMIP_NODES;
+    sub->cfg.mip_cutoff_set = false;
+    {
+        int64_t cap = MIP_SUBMIP_WORK * (m->num_nz + nc + m->num_row);
+        if (limit > 0 && limit < cap)
+            cap = limit;
+        if (m->cfg.work_limit > 0) {
+            const int64_t left = m->cfg.work_limit - *work;
+            if (left < cap)
+                cap = left > 0 ? left : 1;
+        }
+        sub->cfg.work_limit = cap;
+    }
+    const jaos_status st = jaos_solve(sub);
+    *work += sub->solve_work;
+    if (getenv("J32_PROXDBG") != nullptr)
+        fprintf(stderr, "PROX st=%d status=%d nodes=%lld work=%lld cap=%lld inc=%d bound=%g delta=%g incobj=%g\n",
+                (int)st, (int)sub->solve_status, (long long)sub->mip_nodes,
+                (long long)sub->solve_work, (long long)sub->cfg.work_limit,
+                (int)sub->mip_has_incumbent, sub->mip_bound, delta, incobj);
+    got = 0;
+    if (st == JAOS_OK && sub->mip_has_incumbent && sub->mip_inc_x != nullptr) {
+        memcpy(xout, sub->mip_inc_x, (size_t)nc * sizeof *xout);
+        got = 1;
+    } else if (st == JAOS_ERR_OUT_OF_MEMORY) {
+        got = -1;
+    }
+out:
+    jaos_model_free(sub);
+    free(idx);
+    free(val);
+    return got;
+}
