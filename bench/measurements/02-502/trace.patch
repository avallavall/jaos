+
+#include <stdio.h>
+static int dbg_check(const char *tag, const jaos_model *x, int verbose)
+{
+    if (x->solve_status != JAOS_SOLVE_OPTIMAL || x->num_row <= 0 || x->sol_row == nullptr || x->sol_col == nullptr)
+        return 0;
+    double *act = calloc((size_t)x->num_row, sizeof *act);
+    double *tr = calloc((size_t)x->num_row, sizeof *tr);
+    int64_t *nz = calloc((size_t)x->num_row, sizeof *nz);
+    for (int64_t j = 0; j < x->num_col; j++)
+        for (int64_t k = x->a_start[j]; k < x->a_start[j + 1]; k++) {
+            const int64_t i = x->a_index[k];
+            const double t = x->a_value[k] * x->sol_col[j];
+            act[i] += t; tr[i] += fabs(t); nz[i]++;
+        }
+    int bad = 0;
+    for (int64_t i = 0; i < x->num_row; i++) {
+        if (x->sol_row_status[i] != JAOS_BASIS_BASIC) continue;
+        if (!isfinite(act[i]) || !isfinite(x->sol_row[i])) continue;
+        const double w = 8.0 * DBL_EPSILON * (tr[i] > 1.0 ? tr[i] : 1.0);
+        const double win = nz[i] > 1 ? w * (double)(nz[i] - 1) : w;
+        if (fabs(x->sol_row[i] - act[i]) > win) {
+            bad++;
+            if (verbose && bad <= 10)
+                fprintf(stderr, "DBG %s row %lld: sol_row %.17g act %.17g diff %.3g window %.3g traffic %.17g nnz %lld bounds [%.17g, %.17g]\n",
+                        tag, (long long)i, x->sol_row[i], act[i], fabs(x->sol_row[i] - act[i]), win, tr[i], (long long)nz[i], x->row_lower[i], x->row_upper[i]);
+        }
+    }
+    free(act); free(tr); free(nz);
+    if (bad) fprintf(stderr, "DBG %s: %d bad rows of %lld (cols %lld)\n", tag, bad, (long long)x->num_row, (long long)x->num_col);
+    return bad;
+}
