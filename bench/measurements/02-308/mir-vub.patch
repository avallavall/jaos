+typedef struct {
+    int64_t *y;
+    double *u;
+    double *w;
+    double *sub;
+} mir_vub;
+
+static void mir_vub_free(mir_vub *v)
+{
+    free(v->y); free(v->u); free(v->w); free(v->sub);
+    memset(v, 0, sizeof *v);
+}
+
+static bool mir_vub_build(const jaos_model *m, const jaos_model *lp,
+                          const double *ilo, const double *ihi, mir_vub *v,
+                          int64_t *work)
+{
+    const int64_t nc = m->num_col, nr = m->num_row;
+    v->y = jm_alloc_array(nc > 0 ? nc : 1, sizeof *v->y);
+    v->u = jm_alloc_array(nc > 0 ? nc : 1, sizeof *v->u);
+    v->w = jm_alloc_array(nc > 0 ? nc : 1, sizeof *v->w);
+    v->sub = jm_alloc_array(nc > 0 ? nc : 1, sizeof *v->sub);
+    if (v->y == nullptr || v->u == nullptr || v->w == nullptr ||
+        v->sub == nullptr) {
+        mir_vub_free(v);
+        return false;
+    }
+    for (int64_t j = 0; j < nc; j++) {
+        v->y[j] = -1;
+        v->u[j] = INFINITY;
+    }
+    *work += m->num_nz + nc;
+    for (int64_t i = 0; i < nr; i++) {
+        const int64_t p0 = lp->ar_start[i], p1 = lp->ar_start[i + 1];
+        if (p1 - p0 != 2)
+            continue;
+        double sign;
+        if (lp->row_upper[i] == 0.0 && lp->row_lower[i] == -INFINITY)
+            sign = 1.0;
+        else if (lp->row_lower[i] == 0.0 && lp->row_upper[i] == INFINITY)
+            sign = -1.0;
+        else
+            continue;
+        for (int t = 0; t < 2; t++) {
+            const int64_t j = lp->ar_index[p0 + t], y = lp->ar_index[p1 - 1 - t];
+            const double a = sign * lp->ar_value[p0 + t];
+            const double c = sign * lp->ar_value[p1 - 1 - t];
+            if (!(a > 0.0) || !(c < 0.0) || j == y || m->col_integer[j])
+                continue;
+            if (!m->col_integer[y] || ilo[y] != 0.0 || ihi[y] != 1.0)
+                continue;
+            if (ilo[j] != 0.0)
+                continue;
+            const double u = -c / a;
+            if (u < v->u[j]) {
+                v->u[j] = u;
+                v->y[j] = y;
+            }
+        }
+    }
+    return true;
+}
