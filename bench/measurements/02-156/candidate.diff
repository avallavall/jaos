+/* --------------------------------------------------------------------- */
+/* The primal's approximate edge weights                                   */
+/* --------------------------------------------------------------------- */
+
+/* Every weight back to 1. `gamma_j >= 1` for every j — the `+1` from the j
+ * coordinate of the edge vector can never be lost — so 1 is a valid lower
+ * bound for all of them and a reset is always safe to take. It degrades
+ * the rule towards Dantzig and never towards a wrong answer
+ * (`docs/research/approximate-edge-pricing.md` §3). */
+static void primal_edge_reset(sx *s)
+{
+    for (int64_t v = 0; v < s->nvar; v++)
+        s->pedge[v] = 1.0;
+    jm_work_add(&s->work, s->nvar * JM_WORK_NONZERO);
+    s->n_edge_reset++;
+}
+
+/* One variable's share of the update: `w'_j = max(w_j, mu_j^2 w_q)` with
+ * `mu_j = alpha_rj / alpha_rq`. Says whether the weight is still finite. */
+static bool edge_one(sx *s, int64_t v, int64_t q, double wq, double alpha_q)
+{
+    if (v == q || s->status[v] == JM_BASIC)
+        return true;
+    const double mu = s->alpha[v] / alpha_q;
+    const double cand = mu * mu * wq;
+    if (cand > s->pedge[v])
+        s->pedge[v] = cand;
+    return isfinite(s->pedge[v]);
+}
+
+/* One pivot's worth of update, taken while the OLD basis is still in force
+ * and `s->alpha` still holds row r of `B^-1 M`. A variable the pricing row
+ * does not reach has `mu_j = 0` and keeps its weight, so this walks that
+ * row's pattern and no more — the same walk `update_dual` makes just above.
+ *
+ * The leaving variable is the one case the recurrence gives exactly:
+ * `eta'_s = -(1/alpha_rq) eta_q`, so `w'_s = w_q / alpha_rq^2`, floored at
+ * the 1 every weight is bounded below by (§2, Claim 2).
+ *
+ * Returns false when a weight stopped being finite. That is a stall rather
+ * than a wrong answer — a non-finite weight scores zero for ever and its
+ * column would never be priced again — and the caller resets. */
+static bool primal_edge_update(sx *s, int64_t leaving, int64_t q,
+                               double alpha_q)
+{
+    const double wq = s->pedge[q];
+    bool finite = true;
+
+    if (s->anpat < 0) {
+        for (int64_t v = 0; v < s->nvar; v++)
+            finite = edge_one(s, v, q, wq, alpha_q) && finite;
+        jm_work_add(&s->work, s->nvar * JM_WORK_NONZERO);
+    } else {
+        for (int64_t t = 0; t < s->anpat; t++)
+            finite = edge_one(s, s->apat[t], q, wq, alpha_q) && finite;
+        jm_work_add(&s->work, s->anpat * JM_WORK_NONZERO);
+    }
+
+    const double wl = wq / (alpha_q * alpha_q);
+    s->pedge[leaving] = wl > 1.0 ? wl : 1.0;
+    if (!isfinite(s->pedge[leaving]))
+        finite = false;
+    /* q is basic now and is priced again only after it leaves, which sets
+     * its weight from the recurrence above. */
+    s->pedge[q] = 1.0;
+    return finite;
+}
+
+/* The exact weight of the entering column, which costs one pass over a
+ * vector this iteration has already built: `s->col` is `B^-1 M_q` from the
+ * ratio test. Comparing it against the carried weight measures the drift
+ * against the truth rather than guessing at it (§4). */
+static double primal_edge_exact(sx *s)
+{
+    double g = 1.0;
+    if (s->ncpat >= 0) {
+        for (int64_t k = 0; k < s->ncpat; k++) {
+            const double v = s->col[s->cpat[k]];
+            g += v * v;
+        }
+        jm_work_add(&s->work, s->ncpat * JM_WORK_NONZERO);
+    } else {
+        for (int64_t i = 0; i < s->nrow; i++)
+            g += s->col[i] * s->col[i];
+        jm_work_add(&s->work, s->nrow * JM_WORK_NONZERO);
+    }
+    return g;
+}
