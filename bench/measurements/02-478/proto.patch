+static bool repaired_point(const jaos_model *m, double sigma, double *xr,
+                           const double *ra, int64_t *work)
+{
+    const int64_t nr = m->num_row;
+    if (!m->rowwise_valid || m->num_sos > 0 || m->row_ind_col != nullptr ||
+        jm_model_has_quadratic(m))
+        return false;
+    const double tol = jm_primal_tolerance(m);
+    int64_t nv = 0, i0 = -1;
+    for (int64_t i = 0; i < nr; i++) {
+        if (!(ra[i] < m->row_lower[i] - tol || ra[i] > m->row_upper[i] + tol))
+            continue;
+        nv++;
+        if (i0 < 0 || m->ar_start[i + 1] - m->ar_start[i] <
+                          m->ar_start[i0 + 1] - m->ar_start[i0])
+            i0 = i;
+    }
+    *work += nr;
+    if (i0 < 0)
+        return false;
+    const bool over = ra[i0] > m->row_upper[i0] + tol;
+    int64_t best = -1;
+    double best_d = 0.0, best_gain = INFINITY;
+    for (int64_t k = m->ar_start[i0]; k < m->ar_start[i0 + 1]; k++) {
+        const int64_t j = m->ar_index[k];
+        if (!m->col_integer[j] || (m->col_semi != nullptr && m->col_semi[j]))
+            continue;
+        const double d = (m->ar_value[k] > 0.0) == over ? -1.0 : 1.0;
+        const double v = xr[j] + d;
+        if (v < m->col_lower[j] - tol || v > m->col_upper[j] + tol)
+            continue;
+        int64_t fixed = 0;
+        bool ok = true;
+        for (int64_t t = m->a_start[j]; t < m->a_start[j + 1] && ok; t++) {
+            const int64_t i = m->a_index[t];
+            const double lo = m->row_lower[i] - tol, hi = m->row_upper[i] + tol;
+            const double r = ra[i] + d * m->a_value[t];
+            ok = r >= lo && r <= hi;
+            fixed += ra[i] < lo || ra[i] > hi;
+        }
+        *work += m->a_start[j + 1] - m->a_start[j] + 1;
+        if (!ok || fixed < nv)
+            continue;
+        const double gain = sigma * d * m->col_cost[j];
+        if (gain < best_gain) {
+            best_gain = gain;
+            best = j;
+            best_d = d;
+        }
+    }
+    if (best < 0)
+        return false;
+    xr[best] += best_d;
     return true;
 }
 
