+static int64_t bx_lift(bx *s)
+{
+    const jaos_model *m = s->m;
+    const int64_t nv = s->nvar, nr = s->nrow;
+    if (s->augmented || nr == 0)
+        return 0;
+    double *g = jm_alloc_array(nr, sizeof *g);
+    double *u = jm_alloc_array(nr, sizeof *u);
+    double *h = jm_alloc_array(nv, sizeof *h);
+    double *zb = jm_alloc_array(nv, sizeof *zb);
+    double *amax = jm_calloc_array(nv, sizeof *amax);
+    int8_t *side = jm_calloc_array(nv, sizeof *side);
+    int64_t lifted = 0;
+    if (!g || !u || !h || !zb || !amax || !side)
+        goto out;
+    for (int64_t j = 0; j < s->ncol; j++)
+        for (int64_t k = m->a_start[j]; k < m->a_start[j + 1]; k++)
+            if (fabs(s->av[k]) > amax[j])
+                amax[j] = fabs(s->av[k]);
+    for (int64_t i = 0; i < nr; i++)
+        amax[s->ncol + i] = 1.0;
+    const double tol = s->tol_stop * (1.0 + s->norm_b);
+    const int64_t rounds = getenv("J24LIFTR") ? atoll(getenv("J24LIFTR")) : 20;
+    const int dbg = getenv("J24LIFTDBG") ? 1 : 0;
+    for (int64_t round = 0; round < rounds; round++) {
+        int64_t nblocked = 0;
+        for (int64_t j = 0; j < nv; j++) {
+            const uint8_t k = s->kind[j];
+            side[j] = PUSH_FREE;
+            zb[j] = s->z[j];
+            if (k == FIXED) {
+                s->theta[j] = 0.0;
+                continue;
+            }
+            double inv = s->quad[j] + (k == 0 ? BARRIER_FREE_REG : 0.0);
+            const double bl = (k & HAS_LO) ? s->zl[j] / s->w[j] : 0.0;
+            const double bu = (k & HAS_UP) ? s->zu[j] / s->v[j] : 0.0;
+            inv += bl + bu;
+            s->theta[j] = 1.0 / inv;
+            if (k == 0 || !(s->theta[j] * amax[j] * amax[j] < s->delta))
+                continue;
+            side[j] = (k & HAS_LO) && (!(k & HAS_UP) || bl >= bu) ? PUSH_LOWER
+                                                                 : PUSH_UPPER;
+            zb[j] = side[j] == PUSH_LOWER ? s->lo[j] : s->up[j];
+            nblocked++;
+        }
+        jm_work_add(&s->work, 3 * nv * JM_WORK_NONZERO);
+        if (nblocked == 0)
+            break;
+        mul_e(s, zb, g);
+        for (int64_t i = 0; i < nr; i++)
+            g[i] = -g[i];
+        if (form_normal(s) != JAOS_OK)
+            break;
+        memcpy(u, g, (size_t)nr * sizeof *u);
+        for (int q = 0; q < 3; q++) {
+            solve_normal(s, u);
+            for (int64_t i = 0; i < nr; i++)
+                u[i] *= s->delta;
+        }
+        double ug = 0.0;
+        for (int64_t i = 0; i < nr; i++)
+            ug += u[i] * g[i];
+        const double un = inf_norm(u, nr);
+        if (dbg)
+            fprintf(stderr, "LIFT round %lld blocked %lld |g| %.3e |u| %.3e ug %.3e tol %.3e\n", (long long)round, (long long)nblocked, inf_norm(g, nr), un, ug, tol);
+        if (!(un > tol) || !(ug > 0.0))
+            break;
+        mul_et(s, u, h);
+        int64_t e = -1;
+        double best = HUGE_VAL;
+        for (int64_t j = 0; j < nv; j++) {
+            if (side[j] == PUSH_FREE)
+                continue;
+            double r = HUGE_VAL;
+            if (side[j] == PUSH_LOWER && h[j] > 0.0)
+                r = s->zl[j] / h[j];
+            else if (side[j] == PUSH_UPPER && h[j] < 0.0)
+                r = s->zu[j] / -h[j];
+            if (r < best) {
+                best = r;
+                e = j;
+            }
+        }
+        jm_work_add(&s->work, 2 * nv * JM_WORK_NONZERO);
+        if (e < 0)
+            break;
+        const uint8_t ke = s->kind[e];
+        double d = ug / h[e];
+        if ((ke & HAS_LO) && (ke & HAS_UP) && fabs(d) > 0.5 * (s->up[e] - s->lo[e]))
+            d = d > 0.0 ? 0.5 * (s->up[e] - s->lo[e]) : -0.5 * (s->up[e] - s->lo[e]);
+        const bool lo_side = side[e] == PUSH_LOWER;
+        const double gap_old = lo_side ? s->w[e] : s->v[e];
+        const double dual_old = lo_side ? s->zl[e] : s->zu[e];
+        const double gap_new = gap_old + fabs(d);
+        const double dual_new = gap_old * dual_old / gap_new;
+        if (!(gap_new / dual_new * amax[e] * amax[e] >= s->delta) ||
+            (getenv("J24LIFTNEAR") != nullptr && !(gap_old < atof(getenv("J24LIFTNEAR")) * fabs(d)))) {
+            if (dbg)
+                fprintf(stderr, "LIFT round %lld: column %lld would stay blocked (gap %.3e dual %.3e)\n", (long long)round, (long long)e, gap_new, dual_new);
+            break;
+        }
+        double t = best - dual_new / fabs(h[e]);
+        if (!(t > 0.0))
+            t = 0.0;
+        if (getenv("J24DEFL") != nullptr) {
+            double ybig = 0.0, ynew = 0.0;
+            for (int64_t i = 0; i < nr; i++) {
+                if (fabs(s->y[i]) > ybig)
+                    ybig = fabs(s->y[i]);
+                if (fabs(s->y[i] + t * u[i]) > ynew)
+                    ynew = fabs(s->y[i] + t * u[i]);
+            }
+            if (!(ynew <= ybig)) {
+                if (dbg)
+                    fprintf(stderr, "LIFT round %lld: the shift would raise the duals from %.3e to %.3e\n", (long long)round, ybig, ynew);
+                break;
+            }
+        }
+        for (int64_t i = 0; i < nr; i++)
+            s->y[i] += t * u[i];
+        for (int64_t j = 0; j < nv; j++) {
+            if (side[j] == PUSH_LOWER)
+                s->zl[j] -= t * h[j];
+            else if (side[j] == PUSH_UPPER)
+                s->zu[j] += t * h[j];
+        }
+        s->z[e] += d;
+        if (ke & HAS_LO)
+            s->w[e] += d;
+        if (ke & HAS_UP)
+            s->v[e] -= d;
+        if (dbg)
+            fprintf(stderr, "LIFT round %lld enters %lld side %d h %.3e ratio %.3e t %.3e d %.3e gap %.3e->%.3e dual %.3e->%.3e\n", (long long)round, (long long)e, side[e], h[e], best, t, d, gap_old, gap_new, dual_old, lo_side ? s->zl[e] : s->zu[e]);
+        jm_work_add(&s->work, (2 * nv + nr) * JM_WORK_NONZERO);
+        lifted++;
+    }
+out:
+    free(g); free(u); free(h); free(zb); free(amax); free(side);
+    return lifted;
+}
