+        const double gd = f * ct_pc_mean(pc, nc, i, 0, avg);
+        const double gu = (1.0 - f) * ct_pc_mean(pc, nc, i, 1, avg);
+        const double g = gd < gu ? gd : gu;
+        sum += g;
+        if (i == j)
