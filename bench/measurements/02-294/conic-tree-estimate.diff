+static void ct_sift(ct_heap *h, int64_t at)
+{
+    while (at > 0) {
+        const int64_t up = (at - 1) / 2;
+        if (!ct_before(h->v[at], h->v[up]))
+            break;
+        ct_node *t = h->v[at];
+        h->v[at] = h->v[up];
+        h->v[up] = t;
+        at = up;
+    }
+    for (;;) {
+        int64_t best = at;
+        const int64_t l = 2 * at + 1, r = l + 1;
+        if (l < h->n && ct_before(h->v[l], h->v[best]))
+            best = l;
+        if (r < h->n && ct_before(h->v[r], h->v[best]))
+            best = r;
+        if (best == at)
+            break;
+        ct_node *t = h->v[at];
+        h->v[at] = h->v[best];
+        h->v[best] = t;
+        at = best;
+    }
+}
+
+static ct_node *ct_take(ct_heap *h, bool by_est)
+{
+    if (!by_est || h->n == 0)
+        return ct_pop(h);
+    int64_t at = 0;
+    for (int64_t k = 1; k < h->n; k++)
+        if (h->v[k]->est < h->v[at]->est ||
+            (h->v[k]->est == h->v[at]->est && h->v[k]->id < h->v[at]->id))
+            at = k;
+    ct_node *x = h->v[at];
+    h->v[at] = h->v[--h->n];
+    if (at < h->n)
+        ct_sift(h, at);
+    return x;
+}
