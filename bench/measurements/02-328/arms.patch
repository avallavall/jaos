+    }
+clear:
+    for (int64_t t = 0; t < nl; t++) {
+        const int64_t j = c->list[t];
+        c->mark[j] = false;
+        c->g[j] = c->cs[j] = c->val[j] = 0.0;
+        c->bk[j] = 0;
+    }
+    return ret;
+}
