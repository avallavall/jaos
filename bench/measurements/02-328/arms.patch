+        if (p < 0)
+            continue;
+        const double xb = jm_tableau_value(tb, p);
+        const double f0 = xb - floor(xb);
+        if (f0 < MIP_CUT_AWAY || f0 > 1.0 - MIP_CUT_AWAY)
+            continue;
+        tried++;
+        if (jm_tableau_row(tb, p, row) != JAOS_OK) {
+            added = -1;
+            break;
+        }
