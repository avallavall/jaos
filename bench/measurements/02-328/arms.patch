+static bool implied_move(double cand, double old, bool up)
+{
+    if (!isfinite(cand))
+        return false;
+    if (!isfinite(old))
+        return true;
+    const double step = MIP_IMPLIED_MOVE * (1.0 + fabs(old));
+    return up ? cand < old - step : cand > old + step;
+}
