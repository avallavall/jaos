+static bool grid_whole(double v)
+{
+    return fabs(v) < 0x1p52 &&
+           fabs(v - jm_round(v)) <= MIP_OBJ_FIT * fmax(1.0, fabs(v));
+}
+
+static bool grid_side(double v, double beta)
+{
+    return !isfinite(v) || grid_whole(v / beta);
+}
