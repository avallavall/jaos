+static void test_reduced_costs_tighten_general_integer_bounds_at_the_nodes(void)
+{
+    const double c[8] = {7, 5, 9, 4, 6, 8, 3, 5};
+    const double w[16] = {3, 2, 5, 2, 3, 4, 1, 3,
+                          4, 3, 2, 5, 2, 3, 2, 1};
